+static void test_stack_flags_thunk() {
+    // PUSH/PUSH/PUSH/PUSHFD/SUB [ESP+4]/POPFD/RET is an original image
+    // trampoline shape. Its RET transfers to the computed dispatcher and
+    // leaves two metadata words on the guest stack, without changing GPRs.
+    std::vector<uint8_t> code;
+    auto immediate = [&](uint32_t value) {
+        for (unsigned i = 0; i < 4; ++i)
+            code.push_back(uint8_t(value >> (8 * i)));
+    };
+    for (uint32_t value : {CODE + 26, 0x12345678u, NATIVE + 0x117d0u}) {
+        code.push_back(0x68);
+        immediate(value);
+    }
+    code.insert(code.end(), {0x9c, 0x81, 0x6c, 0x24, 0x04});
+    immediate(0x117d0);
+    code.insert(code.end(), {0x9d, 0xc3});
+    CHECK(code.size() == 26);
+    put(CODE, code);
+    for (uint32_t flags : {0x202u, 0x246u, 0xad7u, 0x10202u}) {
+        X86 c = fresh();
+        x86_set_eflags(&c, flags);
+        uint32_t expected_flags = x86_get_eflags(&c) & ~0x30000u;
+        uint32_t before = c.r[R_ESP];
+        wr32(before, RETURN);
+        CHECK(interp_call(&c, CODE) == 1);
+        CHECK(!interp_last_error()[0]);
+        CHECK(c.eip == NATIVE);
+        CHECK(c.r[R_ESP] == before - 8);
+        CHECK(rd32(c.r[R_ESP]) == 0x12345678);
+        CHECK(rd32(c.r[R_ESP] + 4) == CODE + 26);
+        CHECK(rd32(c.r[R_ESP] + 8) == RETURN);
+        CHECK(x86_get_eflags(&c) == expected_flags);
+    }
+    // A lazy integer result must be committed before PUSHFD saves it, and
+    // POPFD must replace the flags generated by the intervening SUB.
+    put(CODE, {0x31, 0xc0, 0x9c, 0x83, 0xc0, 0x01, 0x9d, 0xc3});
+    X86 c = fresh();
+    wr32(c.r[R_ESP], RETURN);
+    CHECK(interp_call(&c, CODE) == 1);
+    CHECK(c.r[R_EAX] == 1 && c.eflags_zf == 1 && c.eflags_cf == 0);
+}
