+static void test_x87_memory() {
+    // Known exact input/result pairs for all accepted arithmetic memory
+    // forms, including reverse SUB/DIV and both float widths.
+    const double expected[] = {8.0, 12.0, 4.0, -4.0, 3.0, 1.0 / 3.0};
+    const unsigned operation[] = {0, 1, 4, 5, 6, 7};
+    for (unsigned width : {4u, 8u}) {
+        for (unsigned index = 0; index < 6; ++index) {
+            for (bool popping : {false, true}) {
+                std::vector<uint8_t> code;
+                auto memory = [&](uint8_t opcode, unsigned group, uint32_t address) {
+                    code.push_back(opcode);
+                    code.push_back(uint8_t((group << 3) | 5));
+                    for (unsigned i = 0; i < 4; ++i)
+                        code.push_back(uint8_t(address >> (i * 8)));
+                };
+                memory(width == 4 ? 0xd9 : 0xdd, 0, DATA);
+                memory(width == 4 ? 0xd8 : 0xdc, operation[index], DATA + 8);
+                memory(width == 4 ? 0xd9 : 0xdd, popping ? 3 : 2, DATA + 16);
+                code.push_back(0xc3);
+                put(CODE, code);
+                wrf64(DATA, 6.0);
+                wrf64(DATA + 8, 2.0);
+                if (width == 4) {
+                    wrf32(DATA, 6.0f);
+                    wrf32(DATA + 8, 2.0f);
+                }
+                X86 c = fresh();
+                c.fpu_tag = 0xffff;
+                c.fpu_cw = 0x037f;
+                x86_set_eflags(&c, 0xad7);
+                uint32_t flags = x86_get_eflags(&c), before = c.r[R_ESP];
+                wr32(before, RETURN);
+                CHECK(interp_call(&c, CODE) == 1);
+                CHECK(!interp_last_error()[0]);
+                CHECK(c.eip == RETURN && c.r[R_ESP] == before + 4);
+                CHECK(width == 4 ? rdf32(DATA + 16) == (float)expected[index]
+                                 : rdf64(DATA + 16) == expected[index]);
+                CHECK(c.fpu_top == (popping ? 0u : 7u));
+                CHECK(c.fpu_tag == (popping ? 0xffffu : 0x3fffu));
+                CHECK(c.fpu_cw == 0x037f);
