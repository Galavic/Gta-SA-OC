+static void test_word_accumulator_compare() {
+    for (uint32_t a : {0u, 1u, 0x195u, 0x196u, 0x197u, 0x7fffu, 0x8000u, 0xffffu}) {
+        put(CODE, {0x66, 0x3d, 0x96, 0x01, 0xc3});
+        X86 c = fresh();
+        c.r[R_EAX] = 0xabcd0000u | a;
+        wr32(c.r[R_ESP], RETURN);
+        CHECK(interp_can_decode(CODE));
+        CHECK(interp_call(&c, CODE));
+        uint32_t result = (a - 0x196u) & 0xffffu;
+        CHECK(c.r[R_EAX] == (0xabcd0000u | a));
+        CHECK(c.eflags_cf == (a < 0x196u));
+        CHECK(c.eflags_zf == (result == 0));
+        CHECK(c.eflags_sf == (result >> 15));
+        CHECK(c.eflags_of == (((a ^ 0x196u) & (a ^ result)) >> 15));
+    }
+}
