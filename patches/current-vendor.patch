+static void test_word_memory_compare() {
+    for (auto bytes : {std::vector<uint8_t>{0x66, 0x81, 0x3b, 0xff, 0xff, 0xc3},
+                       std::vector<uint8_t>{0x66, 0x83, 0x3b, 0xff, 0xc3},
+                       std::vector<uint8_t>{0x66, 0x39, 0x03, 0xc3},
+                       std::vector<uint8_t>{0x66, 0x3b, 0x03, 0xc3}}) {
+        for (uint32_t value : {0u, 0x7fffu, 0x8000u, 0xffffu}) {
+            put(CODE, bytes);
+            X86 c = fresh();
+            c.r[R_EBX] = DATA;
+            c.r[R_EAX] = 0xabcdffffu;
+            wr32(DATA, 0x12340000u | value);
+            wr32(c.r[R_ESP], RETURN);
+            CHECK(interp_call(&c, CODE));
+            bool reverse = bytes[1] == 0x3b;
+            uint32_t a = reverse ? 0xffffu : value, b = reverse ? value : 0xffffu;
+            uint32_t result = (a - b) & 0xffffu;
+            CHECK(c.eflags_cf == (a < b));
+            CHECK(c.eflags_zf == (result == 0));
+            CHECK(c.eflags_sf == (result >> 15));
+            CHECK(c.eflags_of == (((a ^ b) & (a ^ result)) >> 15));
+            CHECK(c.r[R_EAX] == 0xabcdffffu);
+            CHECK(rd32(DATA) == (0x12340000u | value));
+        }
+    }
+}
