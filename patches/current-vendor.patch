+// Win32 drops the trailing spaces and periods of each path component before
+// the file system sees the name. Legacy parsers hand out names like
+// "DATA\DEFAULT.IDE " as a matter of course - the original game's IDE, IPL and
+// ZON lines all carry that suffix - and on Windows they open the plain file.
+static void test_win32_path_component_stripping() {
+    section("win32 path component stripping");
+    std::string dir = win32_game_dir();
+    mkdir_p(dir + "/norm/xdir");
+    FILE *f = fopen((dir + "/norm/xdir/data.ide").c_str(), "wb");
+    check(f != nullptr, "created a file under a clean path");
+    if (f) {
+        fputs("x", f);
+        fclose(f);
+    }
+    win32_invalidate_dir_cache();
+    const std::string want = dir + "/norm/xdir/data.ide";
+    check(win32_host_path("norm\\xdir\\data.ide ") == want,
+          "an open with a trailing space resolves to the same file");
+    check(win32_host_path("norm\\xdir\\data.ide.") == want,
+          "an open with a trailing period resolves to the same file");
+    check(win32_host_path("norm\\xdir\\data.ide. . ") == want,
+          "mixed trailing periods and spaces resolve");
+    check(win32_host_path("norm \\xdir\\data.ide") == want,
+          "a directory component with a trailing space resolves");
+    check(win32_host_path("norm\\xdir\\nope.ide ").empty(),
+          "a name that is missing even after stripping still misses");
+    remove_tree(dir + "/norm");
+    win32_invalidate_dir_cache();
+}
