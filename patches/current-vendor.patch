-// class is the only one the runtime registers.
+// both supported device classes must expose their documented interface IDs.
+static void test_primary_sound_listener() {
+    cpu_reset();
+    uint32_t out = sc(0), desc = sc(0x40), iid = sc(0x80), params = sc(0x100);
+    static const uint8_t listener_iid[16] = {0x84, 0xfa, 0x9a, 0x27, 0x81, 0x49, 0xce, 0x11,
+                                             0xa5, 0x21, 0x00, 0x20, 0xaf, 0x0b, 0xe5, 0x60};
+    memcpy(g_mem + iid, listener_iid, 16);
+    CHECK_EQ(call_shim(tramp("DSOUND.dll", "DirectSoundCreate8"), {0, out, 0}), DS_OK);
+    uint32_t ds = rd32(out);
+    for (uint32_t flags : {DSBCAPS_PRIMARYBUFFER, DSBCAPS_PRIMARYBUFFER | DSBCAPS_CTRL3D}) {
+        gm_zero(desc, DSBUFFERDESC_SIZE);
+        wr32(desc, DSBUFFERDESC_SIZE);
+        wr32(desc + DSBD_OFF_dwFlags, flags);
+        CHECK_EQ(call_method(ds, DS_CreateSoundBuffer, {desc, out, 0}), DS_OK);
+        uint32_t buffer = rd32(out);
+        wr32(out, 0xdeadbeef);
+        uint32_t hr = call_method(buffer, 0, {iid, out});
+        if (!(flags & DSBCAPS_CTRL3D)) {
+            CHECK_EQ(hr, E_NOINTERFACE);
+            CHECK_EQ(rd32(out), 0u);
+            call_method(buffer, 2);
+            continue;
+        }
+        CHECK_EQ(hr, DS_OK);
+        uint32_t listener = rd32(out);
+        CHECK(listener != 0);
+        call_method(buffer, 2); // the listener owns its own reference
+        if (!listener)
+            continue;
+        gm_zero(params, 68);
+        wr32(params, 64);
+        wr32(params + 64, 0xdeadbeef);
+        CHECK_EQ(call_method(listener, 3, {params}), DS_OK);
+        CHECK_EQ(rd32(params + 64), 0xdeadbeefu);
+        wrf32(params + 4, 3.5f);
+        CHECK_EQ(call_method(listener, 10, {params, 0}), DS_OK);
+        CHECK_EQ(call_method(listener, 3, {params}), DS_OK);
+        CHECK_EQ(rdf32(params + 4), 3.5f);
+        wr32(params, 60);
+        CHECK_EQ(call_method(listener, 3, {params}), DSERR_INVALIDPARAM);
+        CHECK_EQ(call_method(listener, 10, {params, 0}), DSERR_INVALIDPARAM);
+        CHECK_EQ(rd32(params + 64), 0xdeadbeefu);
+        call_method(listener, 2);
+    }
+    // A secondary buffer must refuse the listener even through another view.
