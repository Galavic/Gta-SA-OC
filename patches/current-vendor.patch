+static void test_late_backward_destination() {
+    // The first jump skips a block which a later backward jump reaches.
+    // Re-entering that block must execute it, without treating the gap as an
+    // instruction interior or entering adjacent unsupported padding.
+    put(CODE, {0xeb, 0x05, 0x40, 0x49, 0xeb, 0x01, 0xcc, 0x85, 0xc9, 0x75, 0xf7, 0xc3});
+    for (uint32_t count : {0u, 1u, 3u}) {
+        X86 c = fresh();
+        c.r[R_EAX] = 10;
+        c.r[R_ECX] = count;
+        wr32(c.r[R_ESP], RETURN);
+        CHECK(interp_can_decode(CODE));
+        CHECK(interp_call(&c, CODE));
+        CHECK(c.r[R_EAX] == 10 + count);
+        CHECK(c.r[R_ECX] == 0);
+        CHECK(c.eip == RETURN);
+    }
+    // Cache validation covers newly discovered blocks as well as the entry.
+    wr8(CODE + 2, 0x48); // DEC EAX replaces INC EAX in the skipped block.
+    X86 c = fresh();
+    c.r[R_EAX] = 10;
+    c.r[R_ECX] = 2;
+    wr32(c.r[R_ESP], RETURN);
+    CHECK(interp_call(&c, CODE));
+    CHECK(c.r[R_EAX] == 8);
