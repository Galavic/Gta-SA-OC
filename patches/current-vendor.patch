+            check(performance_counter_ticks(ms, 1.0) == uint64_t(ms) * 1000ull,
+                  "normal clock is bit-exact including large uptimes");
+            check(performance_counter_ticks(ms, 2.0) == uint64_t(ms) * 2000ull,
+                  "scale-2 clock matches the diagnostic multiplier");
+        }
+        printf("performance counter: %u checks, %u failures\n", checks, failures);
+        return failures ? 1 : 0;
+    }
+    const bool path_cache = argc == 2 && strcmp(argv[1], "--read-path-cache") == 0;
+    if (path_cache) {
+        os_setenv("RECOMP_READ_PATH_CACHE", "1");
+        os_setenv("RECOMP_PERF_STATS", "1");
+    }
+    mem_init();
+    imports_init();
+    X86 c = {};
+    c.r[R_ESP] = 0x0effff00;
+    if (argc == 2 && !strcmp(argv[1], "--host-events")) {
+        host_event_contracts(&c);
+        printf("host events: %u checks, %u failures\n", checks, failures);
+        mem_shutdown();
+        return failures ? 1 : 0;
+    }
+    if (callbacks_test) {
+        callback_contracts(&c, reuse_callbacks);
+        mem_shutdown();
+        return failures ? 1 : 0;
+    }
+    if (argc == 2 && !strcmp(argv[1], "--perf-watch")) {
+        perf_watch_contracts();
+        printf("perf watch: %u checks, %u failures\n", checks, failures);
+        mem_shutdown();
+        return failures ? 1 : 0;
+    }
+    if (path_cache) {
+        read_path_cache_contracts(&c);
+        printf("read-path cache: %u checks, %u failures\n", checks, failures);
+        mem_shutdown();
+        return failures ? 1 : 0;
+    }
+    if (argc == 2 && strcmp(argv[1], "--strict-unknown") == 0) {
+        os_setenv("RECOMP_STRICT_UNKNOWN", "1");
+        wr32(c.r[R_ESP], 0x12345678);
+        wr16(0x01000000, 0x0b0f); // No interpreted UD2 support: a deliberate unknown body.
+        recomp_unknown_call(&c, 0x01000000);
+        printf("unexpected strict return\n");
+        return 1;
+    }
+    if (argc == 2 && (strcmp(argv[1], "--strict-import") == 0 ||
+                      strcmp(argv[1], "--strict-import-signature") == 0)) {
+        os_setenv("RECOMP_STRICT_IMPORTS", "1");
+        bool signature = strcmp(argv[1], "--strict-import-signature") == 0;
+        uint32_t target = imports_alloc_trampoline(
+            "strict-import-test.dll", signature ? "UnknownConvention" : "MissingImplementation",
+            signature ? unknown_signature_import : nullptr, signature ? ARGC_UNKNOWN : 0);
+        if (!target) {
+            fprintf(stderr, "strict import fixture could not allocate trampoline\n");
+            return 2;
+        }
+        wr32(c.r[R_ESP], 0x12345678);
+        imports_dispatch(&c, target);
+        fprintf(stderr, "unexpected strict import return\n");
+        return 1;
+    }
+    const uint32_t strings = 0x0ee00000, cs = strings + 256;
+    strcpy(reinterpret_cast<char *>(g_mem + strings), "kernel32.dll");
+    uint32_t module = call(&c, "LoadLibraryA", {strings});
+    check(module != 0, "kernel32 has a module handle");
+    strcpy(reinterpret_cast<char *>(g_mem + strings + 32), "InitializeCriticalSectionAndSpinCount");
+    uint32_t resolved = call(&c, "GetProcAddress", {module, strings + 32});
+    check(resolved == imports_resolve("kernel32.dll", "InitializeCriticalSectionAndSpinCount"),
+          "GetProcAddress resolves the same callable spin-count export");
+    call(&c, "GetSystemInfo", {strings + 128});
+    check(rd32(strings + 148) == 1, "the guest exposes one processor");
+    for (uint32_t spin : {0u, 4000u, 0xffffffffu}) {
+        memset(g_mem + cs, 0xa5, 24);
+        wr32(cs - 4, 0x11223344);
+        wr32(cs + 24, 0x55667788);
+        call(&c, "SetLastError", {0x13579});
+        check(call(&c, "InitializeCriticalSectionAndSpinCount", {cs, spin}) == 1,
+              "spin-count initialization returns BOOL success");
+        check(call(&c, "GetLastError", {}) == 0x13579, "initialization preserves last error");
+        check(rd32(cs + 4) == 0xffffffffu && rd32(cs + 8) == 0 && rd32(cs + 12) == 0,
+              "new section is unowned and nonrecursive");
+        check(rd32(cs + 20) == 0, "a single processor ignores the spin count");
+        check(rd32(cs - 4) == 0x11223344 && rd32(cs + 24) == 0x55667788,
+              "initialization stays inside the 24-byte guest object");
+        call(&c, "EnterCriticalSection", {cs});
+        call(&c, "EnterCriticalSection", {cs});
+        check(rd32(cs + 8) == 2 && rd32(cs + 12) != 0, "section ownership permits recursion");
+        call(&c, "LeaveCriticalSection", {cs});
+        call(&c, "LeaveCriticalSection", {cs});
+        check(rd32(cs + 8) == 0 && rd32(cs + 12) == 0, "both leaves release ownership");
+        check(call(&c, "TryEnterCriticalSection", {cs}) == 1, "released section can be reacquired");
+        call(&c, "LeaveCriticalSection", {cs});
+        call(&c, "DeleteCriticalSection", {cs});
+    }
+    strcpy(reinterpret_cast<char *>(g_mem + strings + 32), "IsProcessorFeaturePresent");
+    resolved = call(&c, "GetProcAddress", {module, strings + 32});
+    check(resolved == imports_resolve("kernel32.dll", "IsProcessorFeaturePresent"),
+          "GetProcAddress resolves the same processor-feature export");
+    X86 cpu = {};
+    cpu.r[R_EAX] = 1;
+    recomp_cpuid(&cpu);
+    check((cpu.r[R_EDX] & 0x10) != 0, "CPUID advertises TSC");
+    for (uint32_t feature : {0u, 1u, 2u, 3u, 6u, 8u, 9u, 10u, 12u, 13u, 17u, 0xffffffffu}) {
+        call(&c, "SetLastError", {0x13579});
+        check(call(&c, "IsProcessorFeaturePresent", {feature}) == (feature == 8 ? 1u : 0u),
+              "processor feature agrees with the guest CPU contract");
+        check(call(&c, "GetLastError", {}) == 0x13579, "feature query preserves last error");
+    }
+    printf("%u checks, %u failures\n", checks, failures);
+    mem_shutdown();
+    return failures ? 1 : 0;
+}
