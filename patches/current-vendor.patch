+// The page histogram exists for the watchdog, and the per-trampoline call
+// counter for diagnostics. Dispatch runs about half a million times a second,
+// so both are a store into shared memory on the hottest path in the runtime,
+// and neither is read unless a switch asks for it: the histogram only from
+// watchdog_flush_hist, the counter only from imports_call_count(dll, name).
+bool import_stats_on() {
+    static const bool on = [] {
+        const char *tls = recomp_env("WATCHDOG_TLS");
+        const char *cs = recomp_env("WATCHDOG_CS");
+        return (tls && *tls) || (cs && *cs);
+    }();
+    return on;
