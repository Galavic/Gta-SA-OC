+// Exercise CRT startup imports through the real registry and dispatcher.
+// No image, renderer, generated game code or window is needed.
+#include "../imports.h"
+#include "../memory.h"
+#include "../intrinsics.h"
+#include "../../platform/os.h"
+#include "../perf_stats.h"
+#include "../performance_counter.h"
+#include "../win32.h"
+#include <cstdio>
+#include <cstring>
+#include <initializer_list>
+
+static unsigned checks = 0, failures = 0;
+static void check(bool condition, const char *message) {
+    ++checks;
+    if (!condition) {
+        ++failures;
+        printf("FAIL: %s\n", message);
+    }
+}
+
+static uint32_t call(X86 *c, const char *name, std::initializer_list<uint32_t> args) {
+    uint32_t target = imports_resolve("kernel32.dll", name);
+    check(target != 0, "registered export resolves");
+    check(imports_argc(target) == args.size(), "export has the correct stdcall signature");
+    uint32_t before = c->r[R_ESP];
+    c->r[R_ESP] -= 4 * (args.size() + 1);
+    wr32(c->r[R_ESP], 0x12345678);
+    unsigned index = 0;
+    for (uint32_t value : args)
+        wr32(c->r[R_ESP] + 4 + 4 * index++, value);
+    check(imports_dispatch(c, target), "real import dispatcher handles the call");
+    check(c->r[R_ESP] == before, "stdcall restores the caller stack");
+    check(c->eip == 0x12345678, "stdcall resumes at the caller return address");
+    return c->r[R_EAX];
+}
+
+// This must never execute when its calling convention is unknown. A marker
+// distinguishes rejecting the signature from accidentally calling the shim.
+static void unknown_signature_import(X86 *) {
+    fprintf(stderr, "unexpected strict import implementation\n");
+    fflush(stderr);
+}
+
+static uint32_t callback_target;
+static void host_event_contracts(X86 *c) {
+    for (uint32_t manual : {0u, 1u}) {
+        uint32_t event = call(c, "CreateEventA", {0, manual, 0, 0});
+        for (unsigned i = 0; i < 33; ++i) {
+            // Cover every phase of the sampled import checkpoint. No Sleep,
+            // timer tick or unrelated call may be needed to observe a signal.
+            guest_event_signal_from_host(event);
+            check(call(c, "WaitForSingleObject", {event, 0}) == 0,
+                  "zero-time wait immediately observes a queued host completion");
+            if (manual)
+                call(c, "ResetEvent", {event});
+            check(call(c, "WaitForSingleObject", {event, 0}) == 0x102,
+                  "consumed or reset event stays unsignalled");
+        }
+        call(c, "CloseHandle", {event});
+    }
+}
+
+static void nested_callback(X86 *c) {
+    const uint32_t depth = arg(c, 0);
+    if (depth == 0xffffffffu) {
+        // A translated RET can escape through a sentinel rather than return
+        // through its native caller. The cached checkpoint must support both.
+        c->r[R_EAX] = 99;
+        c->r[R_ESP] += 8;
+        c->eip = GUEST_RETURN_SENTINEL;
+        recomp_callback_return(c);
+        check(false, "sentinel return must reach the active checkpoint");
+    } else if (depth) {
+        const uint32_t next = depth - 1;
+        c->r[R_EAX] = guest_call(c, callback_target, &next, 1) + 1;
+    } else {
+        c->r[R_EAX] = 10;
+    }
+}
+
+static void callback_contracts(X86 *c, bool reuse) {
+    callback_target = imports_alloc_trampoline("test", "NestedCallback", nested_callback, 1);
+    const uint32_t esp = c->r[R_ESP], eip = c->eip;
+    const uint64_t started = os_monotonic_ns();
+    for (uint32_t i = 0; i < 5000; ++i) {
+        uint32_t depth = i % 5 == 0 ? 64 : 0;
+        check(guest_call(c, callback_target, &depth, 1) == depth + 10,
+              "nested callbacks return through distinct checkpoints");
+        check(c->r[R_ESP] == esp && c->eip == eip && recomp_callback_depth() == 0,
+              "callback restores its caller's stack, EIP and depth");
+    }
+    const double elapsed_ms = double(os_monotonic_ns() - started) / 1e6;
+    for (unsigned i = 0; i < 32; ++i) {
+        uint32_t depth = 0xffffffffu;
+        check(guest_call(c, callback_target, &depth, 1) == 99,
+              "reused checkpoint handles a nonlocal sentinel return");
+        check(c->r[R_ESP] == esp && c->eip == eip && recomp_callback_depth() == 0,
+              "sentinel return leaves no active callback");
+    }
+    check(reuse ? perf_stats::callback_reuses > 5000 : perf_stats::callback_reuses == 0,
+          "rollback switch controls checkpoint reuse");
+    check(reuse ? perf_stats::callback_allocations < 35000
+                : perf_stats::callback_allocations == 69032,
+          "bounded pool reduces allocations even beyond its retained depth");
+    printf("callback pool %s: %u checks, %u failures; allocations=%llu reuses=%llu loop_ms=%.3f\n",
+           reuse ? "on" : "off", checks, failures,
+           (unsigned long long)perf_stats::callback_allocations,
+           (unsigned long long)perf_stats::callback_reuses, elapsed_ms);
+}
+
+static std::string resolver_answer;
+static unsigned resolver_calls;
+static int path_resolver(const char *, int, char *out, size_t size) {
+    ++resolver_calls;
+    if (resolver_answer.size() >= size)
+        return 0;
+    memcpy(out, resolver_answer.c_str(), resolver_answer.size() + 1);
+    return 1;
+}
+
+// Exercise real opens and mutations, not cached contents or shared descriptors.
+static void read_path_cache_contracts(X86 *c) {
+    char root[1024];
+    snprintf(root, sizeof root, "%s/recomp-paths-XXXXXX", os_temp_dir());
+    check(os_mkdtemp(root) == 0, "isolated file fixture created");
+    win32_init(root);
+    std::string path = std::string(root) + "/asset.bin";
+    FILE *file = fopen(path.c_str(), "wb");
+    check(file && fwrite("AB", 1, 2, file) == 2, "fixture data written");
+    if (file)
+        fclose(file);
+    const uint32_t name = 0x0ee00000, bytes = name + 512, count = bytes + 16;
+    gm_put_str(name, "asset.bin", 64);
+    auto open = [&] { return call(c, "CreateFileA", {name, 0x80000000u, 1, 0, 3, 0, 0}); };
+    uint32_t first = open(), second = open();
+    check(first != 0xffffffffu && second != 0xffffffffu && first != second,
+          "cached path still opens independent handles");
+    for (uint32_t h : {first, second}) {
+        check(call(c, "ReadFile", {h, bytes, 1, count, 0}) == 1 && rd8(bytes) == 'A' &&
+                  rd32(count) == 1,
+              "each cached open starts at its own offset zero");
+        call(c, "CloseHandle", {h});
+    }
+    uint64_t hits = perf_stats::path_cache_hits;
+    check(win32_host_path(".\\asset.bin ") == path && perf_stats::path_cache_hits == hits + 1,
+          "normalised spelling shares the read path");
+    check(call(c, "DeleteFileA", {name}) == 1 && open() == 0xffffffffu,
+          "deleting a file invalidates the cached read path");
+    file = fopen(path.c_str(), "wb");
+    check(file && fwrite("CD", 1, 2, file) == 2, "missing file recreated externally");
+    if (file)
+        fclose(file);
+    first = open();
+    check(first != 0xffffffffu, "a missing read is not negatively cached");
+    call(c, "CloseHandle", {first});
+    // Changing the game root must not return the old root's cached answer.
+    std::string nested = std::string(root) + "/other";
+    check(os_mkdir(nested.c_str()) == 0, "second root created");
+    win32_init(nested);
+    check(win32_host_path("asset.bin").empty(), "root change invalidates cached paths");
+    win32_init(root);
+    check(win32_host_path("asset.bin") == path, "restoring the root resolves the real file");
+    hits = perf_stats::path_cache_hits;
+    win32_host_path_op("asset.bin", WIN32_FILE_WRITE);
+    check(perf_stats::path_cache_hits == hits, "write lookups bypass the read cache");
+    win32_invalidate_dir_cache();
+    uint64_t misses = perf_stats::path_cache_misses;
+    check(win32_host_path("asset.bin") == path && perf_stats::path_cache_misses == misses + 1,
+          "explicit invalidation forces a fresh lookup");
+    resolver_answer = path;
+    resolver_calls = 0;
+    win32_set_file_ops(path_resolver, nullptr);
+    check(win32_host_path("asset.bin") == path && resolver_calls == 1,
+          "installing an overlay invalidates the base answer");
+    check(win32_host_path("asset.bin") == path && resolver_calls == 1,
+          "unchanged overlay read reuses its resolved path");
+    resolver_answer = nested + "/replacement.bin";
+    win32_invalidate_dir_cache(); // same publication contract used by overlay layer changes
+    check(win32_host_path("asset.bin") == resolver_answer && resolver_calls == 2,
+          "overlay publication invalidation observes the new answer");
+    win32_set_file_ops(nullptr, nullptr);
+    check(win32_host_path("asset.bin") == path, "removing the overlay restores the base answer");
+    os_unlink(path.c_str());
+    os_rmdir(nested.c_str());
+    os_rmdir(root);
+}
+
+static void perf_watch_contracts() {
+    perf_stats::WatchList fields;
+    check(perf_stats::parse_watches("300000:1,300001:2,300003:4", fields) && fields.count == 3,
+          "scalar watch list accepts byte, word and dword fields");
+    wr8(0x300000, 0x81);
+    wr16(0x300001, 0x1234);
+    wr32(0x300003, 0x89abcdef);
+    FILE *capture = tmpfile();
+    check(capture != nullptr, "temporary observation output opens");
+    if (capture) {
