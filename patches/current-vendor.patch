+size_t bytecode_size(const uint8_t *data, size_t available) {
+    if (!data || available < 8)
+        return 0;
+    auto word = [&](size_t i) {
+        uint32_t v;
+        memcpy(&v, data + i * 4, 4);
+        return v;
+    };
+    uint32_t version = word(0), major = (version >> 8) & 255, minor = version & 255;
+    bool pixel = (version >> 16) == 0xffff;
+    if (((version >> 16) != 0xfffe && !pixel) || major < 1 || major > 3)
+        return 0;
+    size_t n = available / 4;
+    for (size_t i = 1; i < n;) {
+        uint32_t token = word(i), op = token & 0xffff;
+        if (token == OP_END)
+            return (i + 1) * 4;
+        int count = operand_count(op, major, minor, pixel);
+        if (op != OP_COMMENT && op != OP_PHASE && count < 0)
+            return 0;
+        size_t length = op == OP_COMMENT ? ((token >> 16) & 0x7fff)
+                        : op == OP_PHASE ? 0
+                        : major >= 2     ? ((token >> 24) & 15)
+                                         : size_t(count);
+        if (length > n - i - 1)
+            return 0;
+        i += 1 + length;
+    }
+    return 0;
+}
