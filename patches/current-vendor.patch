+    CHECK(interp_call(&c, CODE));
+    CHECK(c.r[R_EAX] == 0xffffffff && c.eflags_sf && !c.eflags_zf);
+    put(CODE, {0xf7, 0xe9, 0xc3}); // IMUL ECX: EDX:EAX
+    c = fresh();
+    c.r[R_EAX] = 0x80000000;
+    c.r[R_ECX] = 0xffffffff;
+    wr32(c.r[R_ESP], RETURN);
+    CHECK(interp_call(&c, CODE));
+    CHECK(c.r[R_EAX] == 0x80000000 && c.r[R_EDX] == 0 && c.eflags_cf && c.eflags_of);
