+"""Only the player and its workers belong in a staged web build."""
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+import web_launcher
+
+
+@pytest.mark.parametrize("packaged", [False, True])
+def test_copy_excludes_diagnostic_executables_and_wasm_backups(tmp_path, packaged):
+    build, site = tmp_path / "build", tmp_path / "site"
+    build.mkdir()
+    (build / "index.html").write_text('script.src = "Game.js";', encoding="utf-8")
+    names = ["Game.js", "Game.wasm", "Game.worker.js", "Game.audio_worklet.js",
+             "Game.linked.wasm", "Game.browser.wasm", "Game.stripped.wasm",
+             "probe.js", "probe.wasm", "probe.data"]
+    if packaged:
+        names.append("Game.data")
+    for name in names:
+        (build / name).write_bytes(b"synthetic " + name.encode())
+    web_launcher.copy_web_build("test", build, site)
+    expected = {"index.html", "Game.js", "Game.wasm", "Game.worker.js", "Game.audio_worklet.js"}
+    if packaged:
+        expected.add("Game.data")
+    assert {p.name for p in (site / "test").iterdir()} == expected
+    assert (build / "Game.linked.wasm").is_file()  # source diagnostics are preserved
+
+
+def test_copy_rejects_an_ambiguous_player(tmp_path):
+    build = tmp_path / "build"
+    build.mkdir()
+    (build / "index.html").write_text('"One.js"; "Two.js"', encoding="utf-8")
+    for name in ("One", "Two"):
+        (build / (name + ".js")).write_bytes(b"synthetic")
+        (build / (name + ".wasm")).write_bytes(b"synthetic")
+    with pytest.raises(ValueError, match="one player module"):
+        web_launcher.copy_web_build("test", build, tmp_path / "site")
