+static void test_exchange_shift_and_wide_multiply() {
+    // A stack-addressed exchange must capture both operands before writing,
+    // and must preserve the flags settled by the preceding comparison.
+    put(CODE, {0x39, 0xc0, 0x87, 0x14, 0x24, 0x87, 0x14, 0x24, 0xc3});
+    X86 c = fresh();
+    c.r[R_EDX] = 0x12345678;
+    wr32(c.r[R_ESP], RETURN);
+    CHECK(interp_can_decode(CODE));
+    CHECK(interp_call(&c, CODE));
+    CHECK(c.eip == RETURN && c.r[R_EDX] == 0x12345678);
+    CHECK(c.eflags_zf && !c.eflags_cf && !c.eflags_of);
+    // XCHG [EDX],EDX must write at the old address, not at its new value.
+    put(CODE, {0x87, 0x12, 0x91, 0xc3});
+    c = fresh();
+    c.r[R_EDX] = DATA;
+    c.r[R_EAX] = 12;
+    c.r[R_ECX] = 24;
+    wr32(DATA, 0x87654321);
+    wr32(c.r[R_ESP], RETURN);
+    CHECK(interp_call(&c, CODE));
+    CHECK(rd32(DATA) == DATA && c.r[R_EDX] == 0x87654321);
+    CHECK(c.r[R_EAX] == 24 && c.r[R_ECX] == 12);
+    // Return-address thunk: restore EDX by exchanging the stack temporary,
+    // redirect RET to the computed target and adjust the caller continuation.
+    put(CODE,
+        {0x52, 0xba, 0x00, 0x10, 0x40, 0x00, 0x87, 0x14, 0x24, 0x83, 0x44, 0x24, 0x04, 0x19, 0xc3});
+    c = fresh();
+    c.r[R_EDX] = 0x98765432;
+    uint32_t saved_esp = c.r[R_ESP];
+    wr32(saved_esp, RETURN);
+    CHECK(interp_call(&c, CODE));
+    CHECK(c.eip == NATIVE && c.r[R_EDX] == 0x98765432);
+    CHECK(c.r[R_ESP] == saved_esp && rd32(saved_esp) == RETURN + 0x19);
+    // Zero and masked-zero shift counts preserve all pending flags.
+    for (uint8_t op : {0xe0, 0xe8, 0xf8}) {
+        for (uint8_t count : {0, 32}) {
+            put(CODE, {0x39, 0xc0, 0xc1, op, count, 0xc3});
+            c = fresh();
+            c.r[R_EAX] = 0x80000001;
+            wr32(c.r[R_ESP], RETURN);
+            CHECK(interp_call(&c, CODE));
+            CHECK(c.r[R_EAX] == 0x80000001 && c.eflags_zf && !c.eflags_cf && !c.eflags_of);
+        }
+    }
+    put(CODE, {0xd1, 0xe0, 0xc3}); // SHL EAX,1
+    c = fresh();
+    c.r[R_EAX] = 0x80000001;
+    wr32(c.r[R_ESP], RETURN);
+    CHECK(interp_call(&c, CODE));
+    CHECK(c.r[R_EAX] == 2 && c.eflags_cf && c.eflags_of);
+    put(CODE, {0xd3, 0xf8, 0xc3}); // SAR EAX,CL
+    c = fresh();
