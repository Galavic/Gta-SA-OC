+int recomp_seh_fault(X86 *c, uint32_t code, uint32_t instruction) {
+    c->eip = instruction;
+    recomp_seh_validate_chain(c, "hardware fault", "");
+    X86 saved = *c;
+    SehDispatch *d = new_dispatch(c);
+    wr32(d->record, code);
+    wr32(d->record + 12, instruction);
+    wr32(d->context + 0xb8, instruction);
+    // x86 faults save RF=1 in the hardware context. PUSHFD hides RF and VM.
+    wr32(d->context + 0xc0, x86_get_eflags(c) | 0x10000u);
+    ChainWalk walk;
+    for (uint32_t reg = chain_head(c); reg != END_CHAIN;) {
+        walk.visit(c, reg, 0);
+        uint32_t next = rd32(reg);
+        if (call_handler(c, reg, d, true) == 0) {
+            if (rd32(d->record + 4) & 1u)
+                invalid_chain(c, reg, d->record, "unsupported noncontinuable fault continuation");
+            restore_fault_context(c, saved, d->context);
+            finish_dispatch(d);
+            return 1;
+        }
+        reg = next;
+    }
+    *c = saved;
+    LOGW("SEH: unhandled hardware fault at %08x code=%08x", instruction, code);
+    finish_dispatch(d);
+    return 0;
+}
