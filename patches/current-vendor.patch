+static void test_narrow_moves() {
+    for (uint32_t value : {0x7fu, 0x80u, 0xffu}) {
+        put(CODE, {0x39, 0xd2, 0x0f, 0xbe, 0xc4, 0x0f, 0xb6, 0xd0, 0xc3});
+        X86 c = fresh();
+        c.r[R_EAX] = value << 8;
+        wr32(c.r[R_ESP], RETURN);
+        CHECK(interp_call(&c, CODE));
+        CHECK(c.r[R_EAX] == (value < 128 ? value : value | 0xffffff00u));
+        CHECK(c.r[R_EDX] == value);
+        CHECK(c.eflags_zf && !c.eflags_cf && !c.eflags_of);
+    }
+    // Narrow loads at the arena boundary must require only two valid bytes.
+    put(CODE,
+        {0x39, 0xd2, 0x0f, 0xbf, 0x06, 0x0f, 0xb7, 0x16, 0x66, 0x89, 0x03, 0x66, 0x8b, 0x0b, 0xc3});
+    X86 c = fresh();
+    c.r[R_ESI] = GUEST_SIZE - 2;
+    c.r[R_EBX] = DATA + 4;
+    c.r[R_ECX] = 0x12340000;
+    wr16(GUEST_SIZE - 2, 0xff80);
+    wr32(DATA + 4, 0xaabbccdd);
+    wr32(c.r[R_ESP], RETURN);
+    CHECK(interp_call(&c, CODE));
+    CHECK(c.r[R_EAX] == 0xffffff80 && c.r[R_EDX] == 0xff80);
+    CHECK(rd32(DATA + 4) == 0xaabbff80 && c.r[R_ECX] == 0x1234ff80);
+    CHECK(c.eflags_zf && !c.eflags_cf && !c.eflags_of);
+    put(CODE, {0x66, 0x01, 0xc0, 0xc3}); // unsupported 16-bit ADD stays refused
+    c = fresh();
+    X86 before = c;
+    CHECK(!interp_can_decode(CODE));
+    CHECK(!interp_call(&c, CODE));
+    CHECK(!memcmp(&c, &before, sizeof c));
