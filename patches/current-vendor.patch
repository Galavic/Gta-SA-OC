+// Hotspot map: an import call is bucketed to the 4 KiB guest page of its
+// return address, so a watchdog fire can name where the guest actually
+// spends its runtime traffic without any per-call formatting cost beyond one
+// increment. The table only covers the mapped image layout; trampolines,
+// guest heap and stacks share one overflow bucket. The observing guest
+// thread is the only mutator while it holds the baton, so plain stores are
+// fine and a fire reads a stable table.
+constexpr uint32_t HIST_LO = 0x400000u;
+constexpr uint32_t HIST_SLOTS = 8192u; // 32 MiB at 4 KiB pages
+uint32_t g_page_hist[HIST_SLOTS + 1];
