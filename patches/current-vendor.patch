+        char where[16];
+        if (best_page == HIST_SLOTS)
+            snprintf(where, sizeof where, "outside");
+        else
+            snprintf(where, sizeof where, "%08x", HIST_LO + (best_page << 12));
+        LOGW("hist: rank %u page %s hits %u", rank, where, best_hits);
+        g_page_hist[best_page] = 0;
+    }
+    memset(g_page_hist, 0, sizeof g_page_hist);
