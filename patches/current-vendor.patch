+    // BOOL result and two stdcall arguments; the call helper verifies ESP.
+    memset(g_mem + cs, 0xa5, 24);
+    call_import(c, "KERNEL32.dll", "SetLastError", {0x13579});
+    check(call_import(c, "KERNEL32.dll", "InitializeCriticalSectionAndSpinCount", {cs, 4000}) == 1,
+          "InitializeCriticalSectionAndSpinCount resolves and returns success");
+    check(rd32(cs + 4) == 0xffffffffu && rd32(cs + 8) == 0 && rd32(cs + 12) == 0,
+          "spin-count initialization creates an unowned, nonrecursive section");
+    check(rd32(cs + 20) == 0, "the single guest processor ignores the spin count");
+    check(call_import(c, "KERNEL32.dll", "GetLastError", {}) == 0x13579,
+          "successful critical-section initialization preserves last error");
+    call_import(c, "KERNEL32.dll", "EnterCriticalSection", {cs});
+    call_import(c, "KERNEL32.dll", "EnterCriticalSection", {cs});
+    check(rd32(cs + 8) == 2, "spin-count sections use the existing recursive scheduler lock");
+    call_import(c, "KERNEL32.dll", "LeaveCriticalSection", {cs});
+    call_import(c, "KERNEL32.dll", "LeaveCriticalSection", {cs});
+    call_import(c, "KERNEL32.dll", "DeleteCriticalSection", {cs});
+    for (uint32_t feature : {0u, 1u, 2u, 3u, 6u, 8u, 9u, 10u, 12u, 13u, 17u, 0xffffffffu}) {
+        check(call_import(c, "KERNEL32.dll", "IsProcessorFeaturePresent", {feature}) ==
+                  (feature == 8 ? 1u : 0u),
+              "processor feature %u matches the guest CPUID contract", feature);
+    }
+    check(call_import(c, "KERNEL32.dll", "GetLastError", {}) == 0x13579,
+          "processor-feature queries preserve last error");
