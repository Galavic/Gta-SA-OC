+def msvc_register_frame(register=0):
+    handler = BASE + 0x100
+    raw = b"\x68" + struct.pack("<I", handler)
+    raw += bytes([0x64, 0x8b, 0x05 + register * 8]) + b"\0" * 4
+    raw += bytes([0x50 + register]) + bytes.fromhex("64892500000000")
+    raw += bytes([0x58 + register])
+    raw += bytes([0x64, 0x89, 0x05 + register * 8]) + b"\0" * 4
+    raw += bytes.fromhex("83c404c3")
+    image = synthetic_image({BASE: raw, handler: b"\xc3"}, base=BASE, size=0x1000)
+    insns = image.recover(BASE, set())
+    fn = T.Function(BASE, "msvc_register_frame", len(raw), insns)
+    fn.measure(image)
+    return image, fn, handler
+
+
+@pytest.mark.parametrize("register", [0, 1, 2, 3, 5, 6, 7])
+def test_msvc_register_chain_head_creates_and_retires_checkpoint(register):
+    image, fn, handler = msvc_register_frame(register)
+    translator = T.Translator(image, {BASE, handler}, SimpleNamespace(eager_flags=False))
+    translator.prepare(fn)
+    assert fn.seh_sites == {3: handler}
+    text = "\n".join(translator.translate(fn))
+    assert "recomp_seh_frame_enter(c)" in text
+    assert "if (setjmp(*b_)) { recomp_seh_land(c); return; }" in text
+    assert "recomp_seh_frame_leave(c)" in text
+
+
+@pytest.mark.parametrize("index", [1, 2, 3])
+def test_msvc_register_chain_head_rejects_partial_alternate_entries(index):
+    image, fn, handler = msvc_register_frame()
+    assert T.seh_frame_sites(fn, image, entries={fn.insns[index].addr}) == {}
+    translator = T.Translator(image, {BASE, handler, fn.insns[index].addr},
+                              SimpleNamespace(eager_flags=False))
+    translator.prepare(fn)
+    assert fn.seh_sites == {}
+
+
+@pytest.mark.parametrize("partial_index", [None, 1, 2, 3])
+def test_msvc_frame_borrows_global_entries_without_iteration(partial_index):
+    image, fn, handler = msvc_register_frame()
+
+    class MembershipOnly:
+        def __init__(self):
+            self.values = set(range(50000))
+            if partial_index is not None:
+                self.values.add(fn.insns[partial_index].addr)
+            self.membership_checks = 0
+
+        def __contains__(self, address):
+            self.membership_checks += 1
+            return address in self.values
+
+        def __iter__(self):
+            raise AssertionError("Global function entries must not be copied or iterated")
+
+    entries = MembershipOnly()
+    sites = T.seh_frame_sites(fn, image, entries)
+    assert sites == ({3: handler} if partial_index is None else {})
+    assert 1 <= entries.membership_checks <= 3
+
+
