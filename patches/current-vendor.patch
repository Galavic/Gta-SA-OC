+static void device_shader_destroy(ComObj *dev) {
+    auto it = shader_bindings().find(dev->id);
+    if (it != shader_bindings().end()) {
+        for (uint32_t id : it->second)
+            if (ComObj *o = com_get(id))
+                com_release(o);
+        shader_bindings().erase(it);
+    }
+    auto &p = d9_pipeline(dev->id);
+    p.vs = {};
+    p.ps = {};
+    p.vs_key = p.ps_key = 0;
