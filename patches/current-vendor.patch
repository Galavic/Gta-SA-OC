+
+uint32_t *page_hist_slot(uint32_t ret) {
+    if (ret < HIST_LO || ret - HIST_LO >= HIST_SLOTS * 4096u)
+        return &g_page_hist[HIST_SLOTS];
+    return &g_page_hist[(ret - HIST_LO) >> 12];
