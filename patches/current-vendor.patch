+// A supported FVF installs a real declaration. Failed validation leaves the
+// previous declaration intact, and repeated identical bindings reuse it.
+void Dev_SetFVF(X86 *c) {
+    ComObj *dev = this_device9(c);
+    D9FVF format;
+    std::string why;
+    uint32_t fvf = arg(c, 1);
+    if (!dev || !d9_fvf_decode(fvf, format, why)) {
+        LOGW("d3d9: SetFVF refused: %s", why.c_str());
+        com_ret(c, D3DERR_INVALIDCALL);
+        return;
+    }
+    D9Pipeline &p = d9_pipeline(dev->id);
+    if (p.fvf_cached != fvf || !com_get(p.fvf_declaration)) {
+        ComObj *decl = com_new(K_D3D9DECL);
+        if (!decl) {
+            com_ret(c, E_OUTOFMEMORY);
+            return;
+        }
+        decl->dev_d3d = dev->id;
+        decl->blob = std::move(format.declaration);
+        ComObj *old = com_get(p.fvf_declaration);
+        p.fvf_declaration = decl->id;
+        p.fvf_cached = fvf;
+        if (old)
+            com_release(old);
+    }
+    p.fvf = fvf;
+    p.declaration = dev->current_viewport = p.fvf_declaration;
+    com_ret(c, D3D_OK9);
+}
