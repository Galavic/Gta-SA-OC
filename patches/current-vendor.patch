+    snprintf(edge, sizeof edge, "%x:4", GUEST_SIZE - 3);
+    check(!perf_stats::parse_watches(edge, fields), "range crossing arena end is rejected");
+    snprintf(edge, sizeof edge, "%x:4", GUEST_SIZE - 4);
+    check(perf_stats::parse_watches(edge, fields), "range ending at arena boundary is valid");
+    check(perf_stats::parse_watches(nullptr, fields) && fields.count == 0,
+          "absent configuration disables observations");
+}
