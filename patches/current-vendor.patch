+    uint32_t cs_once = cs && *cs ? (uint32_t)strtoul(cs, nullptr, 10) : 0;
+    LOGW("watchdog: RECOMP_WATCHDOG_TLS=%s RECOMP_WATCHDOG_CS=%s", tls ? tls : "unset",
