+class BytesImage(object):
+    """Synthetic bytes with a real decoder, so the XOR/JZ proof can fire.
+
+    NoImage deliberately exposes no decoder; this stub exposes just enough
+    original bytes for measure() and constant_zero_branches() to run the
+    same checks they run on game listings."""
+
+    def __init__(self, base, code):
+        self.base = base
+        self.data = code
+        self.end = base + len(code)
+        self.md = capstone.Cs(capstone.CS_ARCH_X86, capstone.CS_MODE_32)
+        self.withdrawn_entries = frozenset()
+
+    def insn_end(self, addr, mnem):
+        got = list(self.md.disasm(self.data[addr - self.base:addr - self.base + 16],
+                                  addr, count=1))
+        return got[0].address + got[0].size if got else None
+
+    def is_exec(self, va):
+        return self.base <= va < self.end
+
+
+DEAD_CALL_FN, DEAD_CALL, AFTER_DEAD_CALL, TAIL_JUMP = (
+    0x00401000, 0x00401004, 0x00401009, 0x0040100b)
+DEAD_CALL_LISTING = (
+    "00401000  XOR EAX,EAX\n"
+    "00401002  JZ 0x00401009\n"
+    "00401004  CALL 0x00ffffff\n"
+    "00401009  NOP\n"
+    "0040100a  RET\n"
+    "0040100b  JMP EDI\n")
+DEAD_CALL_CODE = bytes.fromhex("31C0 7405 E8F6EFFFFF 90 C3 FFE7")
+
+
+def translate_withdrawn(listing, entries, withdrawn):
+    image = BytesImage(DEAD_CALL_FN, DEAD_CALL_CODE)
+    image.withdrawn_entries = frozenset(withdrawn)
+    tr = T.Translator(image, {DEAD_CALL_FN}, Opts())
+    fn = T.Function(DEAD_CALL_FN, "f", len(DEAD_CALL_CODE),
+                    T.parse_listing_text(listing))
+    fn.measure(image)
+    tr.prepare(fn)
+    return "\n".join(tr.translate(fn, entries)), tr
+
+
+def translate_withdrawn_inner_start(listing, entries, withdrawn):
+    """Same, but a recovered function also starts at the computed jump, so
+    the address reaches roots through func_addrs as well as entries."""
+    image = BytesImage(DEAD_CALL_FN, DEAD_CALL_CODE)
+    image.withdrawn_entries = frozenset(withdrawn)
+    tr = T.Translator(image, {DEAD_CALL_FN, TAIL_JUMP}, Opts())
+    fn = T.Function(DEAD_CALL_FN, "f", len(DEAD_CALL_CODE),
+                    T.parse_listing_text(listing))
+    fn.measure(image)
+    tr.prepare(fn)
+    return "\n".join(tr.translate(fn, entries)), tr
+
+
+def test_a_guess_entry_keeps_a_proven_dead_call_alive():
+    """A computed jump reached only through a guess entry voids the XOR/JZ
+    proof, so the dead off-image call is still emitted."""
+    text, _ = translate_withdrawn(DEAD_CALL_LISTING, [TAIL_JUMP], [])
+    assert "00ffffff" in text
+
+
+def test_a_withdrawn_entry_lets_the_proof_drop_the_dead_call():
+    """Withdrawing that guess entry leaves the computed jump unreachable,
+    the proof fires, and the dead call is never emitted."""
+    text, tr = translate_withdrawn(DEAD_CALL_LISTING, [TAIL_JUMP], [TAIL_JUMP])
+    assert "00ffffff" not in text
+    assert tr.stats["_withdrawn_entries"] == 1
+
+
+def test_a_withdrawn_inner_start_does_not_keep_the_proof_voided():
