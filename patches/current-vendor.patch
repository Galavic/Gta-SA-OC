+static void create_shader(X86 *c, bool pixel) {
+    ComObj *dev = this_device9(c);
+    uint32_t input = arg(c, 1), out = arg(c, 2);
+    if (!out || !gm_valid(out, 4)) {
+        com_ret(c, D3DERR_INVALIDCALL);
+        return;
+    }
+    wr32(out, 0);
+    if (!dev || !input || !gm_valid(input, 8)) {
+        com_ret(c, D3DERR_INVALIDCALL);
+        return;
+    }
+    size_t size =
+        d9sh::bytecode_size(gm_ptr(input), std::min(size_t(GUEST_SIZE - input), size_t(65536)));
+    if (!size || ((rd32(input) >> 16) == 0xffff) != pixel) {
+        com_ret(c, D3DERR_INVALIDCALL);
+        return;
+    }
+    auto code = std::make_shared<const std::vector<uint8_t>>(gm_ptr(input), gm_ptr(input) + size);
+    const auto &program = d9sh::program_for(*code);
+    if (!program.ok) {
+        LOGW("d3d9: shader refused: %s", program.why.c_str());
+        com_ret(c, D3DERR_INVALIDCALL);
+        return;
+    }
