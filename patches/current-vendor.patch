+static void test_x87_compare_status() {
+    for (bool popping : {false, true}) {
+        for (bool wide : {false, true}) {
+            for (int relation = 0; relation < 4; ++relation) {
+                std::vector<uint8_t> bytes = {0x39,
+                                              0xc0,
+                                              (uint8_t)(wide ? 0xdc : 0xd8),
+                                              (uint8_t)(popping ? 0x1b : 0x13),
+                                              0xdf,
+                                              0xe0,
+                                              0xc3};
+                put(CODE, bytes);
+                X86 c = fresh();
+                c.r[R_EAX] = 0xabcd1234;
+                c.r[R_EBX] = DATA;
+                if (wide)
+                    wrf64(DATA, 2.0);
+                else
+                    wrf32(DATA, 2.0f);
+                double value = relation == 0   ? 1.0
+                               : relation == 1 ? 2.0
+                               : relation == 2 ? 3.0
+                                               : NAN;
+                fpush(&c, value);
+                uint32_t top = c.fpu_top;
+                wr32(c.r[R_ESP], RETURN);
+                CHECK(interp_call(&c, CODE));
+                uint16_t expected = relation == 0   ? 0x100
+                                    : relation == 1 ? 0x4000
+                                    : relation == 2 ? 0
+                                                    : 0x4501;
+                CHECK((c.r[R_EAX] & 0x4701u) == expected);
+                CHECK((c.r[R_EAX] & 0xffff0000u) == 0xabcd0000u);
+                CHECK(c.fpu_top == ((top + (popping ? 1 : 0)) & 7));
+                CHECK(((c.r[R_EAX] >> 11) & 7) == c.fpu_top);
+                CHECK(c.eflags_zf == 1 && c.eflags_cf == 0 && c.eflags_of == 0);
+            }
+        }
+    }
+}
