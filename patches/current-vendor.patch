diff --git a/CMakeLists.txt b/CMakeLists.txt
index 10a37a1..7a558df 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -15,6 +15,22 @@ if(EMSCRIPTEN)
   # EM_ASM and EM_JS, in SDL and in the web host, need the GNU dialects.
   set(CMAKE_C_EXTENSIONS ON)
   set(CMAKE_CXX_EXTENSIONS ON)
+  # Wasm exception handling instead of Emscripten's JavaScript setjmp/longjmp.
+  #
+  # With the JS implementation, any indirect call in a translation unit that can
+  # throw is compiled to an invoke_* import: a wasm -> JS -> wasm round trip
+  # that copies the arguments and reconstructs the frame. The translated guest
+  # code dispatches every call through a function pointer
+  # (recomp_call -> recomp_base_ptrs[i](c)), and the game is C++ reached through
+  # vtables, so that wrapper sat on thousands of calls per frame and showed up
+  # as its own slice of the profile.
+  #
+  # With -fwasm-exceptions the same dispatch is a plain wasm call_indirect and
+  # longjmp unwinds the wasm stack natively, which is what the resumable-stack
+  # design (translate.resumable_stacks) actually needs. Every object in the
+  # image has to agree, so this is a whole-build flag and not a per-target one.
+  add_compile_options(-fwasm-exceptions)
+  add_link_options(-fwasm-exceptions -sSUPPORT_LONGJMP=wasm)
 endif()
 set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
