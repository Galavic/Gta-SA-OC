+// The byte ALU/MOV forms and the direction flag: the CRT's CMP byte ptr
+// [ESI],BL and SEH prologues' CLD run through the interpreter when no
+// translated entry covers them. Flags come from the 8-bit result, and the
+// untouched high bytes of registers and neighbors stay intact.
+static void test_byte_alu_and_direction() {
+    // CMP [ESI],BL with [ESI]=0x09, BL=0x09 -> ZF; then JZ taken.
+    // MOV AL,[ESI]; ADD AL,BL with carry out of bit 7 -> CF/ZF/AF/SF/OF/PF.
+    // CLD clears DF; STD sets it back.
+    put(CODE, {0x38, 0x1e, // cmp byte ptr [esi], bl
+               0x74, 0x02, // jz +2
+               0xb0, 0xff, // mov al, 0xff (skipped)
+               0x8a, 0x06, // mov al, [esi]
+               0x00, 0xd8, // add al, bl
+               0x88, 0x07, // mov [edi], al
+               0xfc,       // cld
+               0xfd,       // std
+               0xc3});     // ret
+    X86 c = fresh();
+    c.r[R_ESI] = DATA + 0x40;
+    c.r[R_EDI] = DATA + 0x50;
+    c.r[R_EBX] = 0x12340009u; // BL=0x09, high bytes must survive
+    c.r[R_EAX] = 0xdeadbe00u;
+    wr8(DATA + 0x40, 0x09);
+    wr32(c.r[R_ESP], RETURN);
+    CHECK(interp_call(&c, CODE) == 1);
+    // 0x09+0x09=0x12: no carry, ZF=0, SF=0, PF=1 (two bits), AF=1 (nibble carry).
+    CHECK(c.r[R_EAX] == 0xdeadbe12u);
+    CHECK(rd8(DATA + 0x50) == 0x12);
+    CHECK(rd8(DATA + 0x51) == 0); // one byte only
+    CHECK(c.eflags_cf == 0 && c.eflags_zf == 0 && c.eflags_sf == 0);
+    CHECK(c.eflags_pf == 1 && c.eflags_af == 1 && c.eflags_of == 0);
+    CHECK(c.eflags_df == 1); // STD last
+    CHECK(c.r[R_EBX] == 0x12340009u);
+    CHECK(c.eip == RETURN);
+
+    // Carry out of the byte: 0xf7+0x09=0x00 with CF/ZF/AF/PF, SF=0, OF=0.
+    // AH (high byte) load/store round-trips without touching AL.
+    put(CODE, {0x8a, 0x26, // mov ah, [esi]
+               0x00, 0xdc, // add ah, bl
+               0x88, 0x27, // mov [edi], ah
+               0xc3});     // ret
+    c = fresh();
+    c.r[R_ESI] = DATA + 0x40;
+    c.r[R_EDI] = DATA + 0x50;
+    c.r[R_EBX] = 0x00000009u; // BL=0x09
+    c.r[R_EAX] = 0x000000f7u; // AL=0xf7 must survive AH writes
+    wr8(DATA + 0x40, 0xf7);
+    wr32(c.r[R_ESP], RETURN);
+    CHECK(interp_call(&c, CODE) == 1);
+    CHECK(c.r[R_EAX] == 0x000000f7u); // AL intact, AH back to 0x00
+    CHECK(rd8(DATA + 0x50) == 0x00);
+    CHECK(c.eflags_cf == 1 && c.eflags_zf == 1 && c.eflags_af == 1);
+    CHECK(c.eflags_sf == 0 && c.eflags_of == 0 && c.eflags_pf == 1);
+    CHECK(c.eip == RETURN);
+}
