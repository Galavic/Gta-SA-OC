+            code.insert(code.end(), {0xe8, 0, 0, 0, 0});
+        code.insert(code.end(), {0x83, 0xc4, 0x04, 0x89, 0x03, // ADD ESP,4; MOV [EBX],EAX
+                                 0xb9, 0x88, 0x77, 0x66, 0x55, 0xc3});
+        put(CODE, code);
+        if (!indirect)
+            put_call(site, NATIVE);
+        X86 c = fresh();
+        c.r[R_EDX] = NATIVE;
+        c.r[R_EBX] = DATA + 0x40;
+        const uint32_t esp = c.r[R_ESP];
+        wr32(esp, RETURN);
+        wr32(DATA + 0x40, 0xaabbccdd);
+        g_native_calls = 0;
+        CHECK(interp_call(&c, CODE) == 1);
+        CHECK(g_native_calls == 1);
+        CHECK(c.r[R_EAX] == 6);
+        CHECK(c.r[R_ECX] == 0x55667788);
+        CHECK(rd32(DATA + 0x40) == 6);
+        CHECK(c.eip == RETURN);
+        CHECK(c.r[R_ESP] == esp + 4);
