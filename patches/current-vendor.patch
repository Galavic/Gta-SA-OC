new file mode 100644
index 0000000..4c116ad
--- /dev/null
+++ b/dx/d3d9_ffp.cpp
@@ -0,0 +1,728 @@
+#include "d3d9_ffp.h"
+#include "d3d9_shader.h"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <initializer_list>
+
+namespace {
+using namespace d9sh;
+struct Code {
+    std::vector<uint8_t> bytes;
+    void word(uint32_t x) {
+        for (unsigned k = 0; k < 4; ++k)
+            bytes.push_back((uint8_t)(x >> (8 * k)));
+    }
+    void op(uint32_t opcode, std::initializer_list<uint32_t> operands) {
+        word(opcode | ((uint32_t)operands.size() << 24));
+        for (uint32_t x : operands)
+            word(x);
+    }
+    D9ShaderBytes finish() {
+        word(OP_END);
+        return {std::make_shared<const std::vector<uint8_t>>(std::move(bytes))};
+    }
+};
+uint32_t reg(uint32_t type, uint32_t index) {
+    return 0x80000000u | ((type & 7) << 28) | ((type & 0x18) << 8) | index;
+}
+uint32_t dst(uint32_t type, uint32_t index, uint32_t mask = 15, bool sat = false) {
+    return reg(type, index) | (mask << 16) | (sat ? 0x00100000u : 0);
+}
+uint32_t src(uint32_t type, uint32_t index, uint32_t swizzle = 0xe4) {
+    return reg(type, index) | (swizzle << 16);
+}
+// Replaces the swizzle of an operand that is already encoded: the swizzle lives
+// in bits 16..23, one two-bit selector per component.
+uint32_t swz(uint32_t operand, uint32_t swizzle) {
+    return (operand & ~0xff0000u) | (swizzle << 16);
+}
+void declare(Code &c, uint32_t type, uint32_t index, uint32_t usage, uint32_t usage_index = 0) {
+    c.op(OP_DCL, {0x80000000u | usage | (usage_index << 16), dst(type, index)});
+}
+void element(D9FVF &f, uint32_t type, uint32_t usage, uint32_t index, uint32_t size) {
+    auto &d = f.declaration;
+    d.insert(d.end(), {0, 0, (uint8_t)f.stride, (uint8_t)(f.stride >> 8), (uint8_t)type, 0,
+                       (uint8_t)usage, (uint8_t)index});
+    f.stride += size;
+}
+bool fail(std::string &why, const char *message) {
+    why = message;
+    return false;
+}
+// Same, with the offending state appended. The refusal log is deduplicated per
+// message, so the detail turns one opaque line into a description of the exact
+// declaration or texture stage the application bound.
+bool fail(std::string &why, const std::string &message) {
+    why = message;
+    return false;
+}
+void multiply(const float *a, const float *b, float *out) {
+    for (unsigned row = 0; row < 4; ++row)
+        for (unsigned col = 0; col < 4; ++col) {
+            out[4 * row + col] = 0;
+            for (unsigned k = 0; k < 4; ++k)
+                out[4 * row + col] += a[4 * row + k] * b[4 * k + col];
+        }
+}
+// Argument sources are captured before CURRENT is updated. Each operation
+// has its own temporary operands so alpha replication/complement cannot
+// accidentally overwrite the previous stage or the sampled texel.
+bool argument(Code &c, uint32_t value, uint32_t temp, uint32_t &operand, std::string &why) {
+    if (value & ~0x3fu)
+        return fail(why, "unsupported texture argument flags: " + std::to_string(value));
+    uint32_t swizzle = value & 0x20 ? 0xff : 0xe4;
+    switch (value & 15) {
+    case 0:
+        operand = src(R_INPUT, 0, swizzle);
+        break;
+    case 1:
+        operand = src(R_TEMP, 0, swizzle);
+        break;
+    case 2:
+        operand = src(R_TEMP, 1, swizzle);
+        break;
+    case 3:
+        operand = src(R_CONST, 0, swizzle);
+        break;
+    case 4:
+        operand = src(R_INPUT, 1, swizzle);
+        break;
+    default:
+        return fail(why, "unsupported texture argument source: " + std::to_string(value & 15) +
+                         " in " + std::to_string(value));
+    }
+    if (value & 0x10) {
+        c.op(OP_SUB, {dst(R_TEMP, temp), src(R_CONST, 1, 0), operand});
+        operand = src(R_TEMP, temp);
+    }
+    return true;
+}
+bool combine(Code &c, uint32_t operation, uint32_t a, uint32_t b, uint32_t mask, std::string &why) {
+    uint32_t d = dst(R_TEMP, 4, mask, true);
+    // The previous stage's result is the "current" colour in D3D's stage
+    // semantics, and it lives in r0 until the stage is committed.
+    uint32_t current = src(R_TEMP, 0);
+    auto lerp = [&](uint32_t factor) {
+        c.op(OP_SUB, {dst(R_TEMP, 5, mask), a, current});
+        c.op(OP_MUL, {dst(R_TEMP, 5, mask), src(R_TEMP, 5), factor});
+        c.op(OP_ADD, {d, src(R_TEMP, 5), current});
+    };
+    switch (operation) {
+    case 2:
+        c.op(OP_MOV, {d, a});
+        break;
+    case 3:
+        c.op(OP_MOV, {d, b});
+        break;
+    case 4:
+        c.op(OP_MUL, {d, a, b});
+        break;
+    case 5:
+    case 6:
+        // Scale before saturating: saturating the initial product is wrong
+        // for signed arguments and would change the DX9 stage semantics.
+        c.op(OP_MUL, {dst(R_TEMP, 4, mask), a, b});
+        c.op(OP_MUL, {d, src(R_TEMP, 4), src(R_CONST, 1, operation == 5 ? 0x55 : 0xaa)});
+        break;
+    case 7:
+        c.op(OP_ADD, {d, a, b});
+        break;
+    case 8: // ADDSIGNED: a + b - 0.5
+        c.op(OP_ADD, {dst(R_TEMP, 4, mask), a, b});
+        c.op(OP_SUB, {d, src(R_TEMP, 4), src(R_CONST, 1, 0xff)});
+        break;
+    case 9: // ADDSIGNED2X: (a + b - 0.5) * 2
+        c.op(OP_ADD, {dst(R_TEMP, 4, mask), a, b});
+        c.op(OP_SUB, {dst(R_TEMP, 4, mask), src(R_TEMP, 4), src(R_CONST, 1, 0xff)});
+        c.op(OP_MUL, {d, src(R_TEMP, 4), src(R_CONST, 1, 0x55)});
+        break;
+    case 10:
+        c.op(OP_SUB, {d, a, b});
+        break;
+    case 11: // ADDSMOOTH: a + b - a*b
+        c.op(OP_MUL, {dst(R_TEMP, 5, mask), a, b});
+        c.op(OP_ADD, {dst(R_TEMP, 4, mask), a, b});
+        c.op(OP_SUB, {d, src(R_TEMP, 4), src(R_TEMP, 5)});
+        break;
+    case 12: // BLENDDIFFUSEALPHA: lerp(current, a, diffuse alpha)
+        lerp(src(R_INPUT, 0, 0xff));
+        break;
+    case 13: // BLENDTEXTUREALPHA: lerp(current, a, texture alpha)
+        lerp(src(R_TEMP, 1, 0xff));
+        break;
+    case 14: // BLENDFACTORALPHA: lerp(current, a, texture factor alpha)
+        lerp(src(R_CONST, 0, 0xff));
+        break;
+    case 16: // BLENDCURRENTALPHA: lerp(current, a, current alpha)
+        lerp(src(R_TEMP, 0, 0xff));
+        break;
+    case 17: // PREMODULATE: rgb * arg2 alpha, alpha unchanged
+        if (mask & 7)
+            c.op(OP_MUL, {dst(R_TEMP, 4, 7), a, swz(b, 0xff)});
+        if (mask & 8)
+            c.op(OP_MOV, {dst(R_TEMP, 4, 8), swz(a, 0xff)});
+        break;
+    case 18: // MODULATEALPHA_ADDCOLOR: rgb * alpha + arg2 rgb, arg2 alpha
+        if (mask & 7) {
+            c.op(OP_MUL, {dst(R_TEMP, 5, 7), a, swz(a, 0xff)});
+            c.op(OP_ADD, {dst(R_TEMP, 4, 7, true), src(R_TEMP, 5), b});
+        }
+        if (mask & 8)
+            c.op(OP_MOV, {dst(R_TEMP, 4, 8), swz(b, 0xff)});
+        break;
+    case 19: // MODULATECOLOR_ADDALPHA: arg2 rgb, arg1 alpha * arg2 alpha
+        if (mask & 7)
+            c.op(OP_MOV, {dst(R_TEMP, 4, 7), b});
+        if (mask & 8) {
+            c.op(OP_MUL, {dst(R_TEMP, 5, 8), swz(a, 0xff), swz(b, 0xff)});
+            c.op(OP_MOV, {dst(R_TEMP, 4, 8), src(R_TEMP, 5)});
+        }
+        break;
+    case 25: // DOTPRODUCT3: (a . b) replicated into all four channels
+        c.op(OP_DP3, {dst(R_TEMP, 4), a, b});
+        if (mask != 15)
+            c.op(OP_MOV, {d, src(R_TEMP, 4)});
+        break;
+    case 26: // MULTIPLYADD: a*b + current
+        c.op(OP_MUL, {dst(R_TEMP, 5, mask), a, b});
+        c.op(OP_ADD, {d, src(R_TEMP, 5), current});
+        break;
+    case 27: // LERP: a*b + current*(1 - b)
+        c.op(OP_MUL, {dst(R_TEMP, 5, mask), a, b});
+        c.op(OP_SUB, {dst(R_TEMP, 4, mask), src(R_CONST, 1, 0), b});
+        c.op(OP_MUL, {dst(R_TEMP, 4, mask), src(R_TEMP, 4), current});
+        c.op(OP_ADD, {d, src(R_TEMP, 5), src(R_TEMP, 4)});
+        break;
+    default:
+        return fail(why, "unsupported texture stage operation: " + std::to_string(operation));
+    }
+    return true;
+}
+} // namespace
+
+bool d9_fvf_decode(uint32_t fvf, D9FVF &format, std::string &why) {
+    D9FVF f;
+    uint32_t position = fvf & 0x400e, count = (fvf >> 8) & 15;
+    if ((fvf & ~0x0fd6u) || count > 8 || (position != 2 && position != 4))
+        return fail(why, "unsupported FVF position, UV dimensions, or reserved flags");
+    f.transformed = position == 4;
+    if (f.transformed && (fvf & 0x10))
+        return fail(why, "XYZRHW and NORMAL are mutually exclusive");
+    element(f, f.transformed ? 3 : 2, f.transformed ? 9 : 0, 0, f.transformed ? 16 : 12);
+    if (fvf & 0x10) {
+        element(f, 2, 3, 0, 12);
+        f.normal = true;
+    }
+    f.diffuse = (fvf & 0x40) != 0;
+    f.specular = (fvf & 0x80) != 0;
+    if (f.diffuse)
+        element(f, 4, 10, 0, 4);
+    if (f.specular)
+        element(f, 4, 10, 1, 4);
+    f.textures = count;
+    for (uint32_t i = 0; i < count; ++i)
+        element(f, 1, 5, i, 8);
+    f.declaration.insert(f.declaration.end(), {0xff, 0, 0, 0, 17, 0, 0, 0});
+    format = std::move(f);
+    why.clear();
+    return true;
+}
+
+bool d9_declaration_fvf(const std::vector<uint8_t> &declaration, uint32_t &fvf, std::string &why) {
+    uint32_t candidate = 0, textures = 0;
+    if (declaration.size() < 16 || declaration.size() % 8)
+        return fail(why, "missing or truncated fixed-function declaration");
+    // One line describing every element, so a refusal names the whole layout
+    // rather than only the first element that does not fit.
+    auto layout = [&declaration]() {
+        std::string out;
+        for (size_t at = 0; at + 8 <= declaration.size(); at += 8) {
+            const uint8_t *e = declaration.data() + at;
+            if (e[4] == 17)
+                break;
+            out += " [stream " + std::to_string(e[0] | (e[1] << 8)) + " offset " +
+                   std::to_string(e[2] | (e[3] << 8)) + " type " + std::to_string(e[4]) +
+                   " usage " + std::to_string(e[6]) + " index " + std::to_string(e[7]) + "]";
+        }
+        return out;
+    };
+    for (size_t at = 0; at + 8 < declaration.size(); at += 8) {
+        const uint8_t *e = declaration.data() + at;
+        if (e[0] || e[1] || e[5])
+            return fail(why, "fixed-function declaration requires stream zero and default method:"
+                              " element " + std::to_string(at / 8) + " stream " +
+                              std::to_string(e[0] | (e[1] << 8)) + " offset " +
+                              std::to_string(e[2] | (e[3] << 8)) + " type " +
+                              std::to_string(e[4]) + " method " + std::to_string(e[5]) +
+                              " usage " + std::to_string(e[6]) + " index " +
+                              std::to_string(e[7]) + " in" + layout());
+        if (e[6] == 0 && e[7] == 0 && e[4] == 2)
+            candidate |= 2; // FLOAT3 POSITION
+        else if (e[6] == 9 && e[7] == 0 && e[4] == 3)
+            candidate |= 4; // FLOAT4 POSITIONT
+        else if (e[6] == 3 && e[7] == 0 && e[4] == 2)
+            candidate |= 0x10;
+        else if (e[6] == 10 && e[7] < 2 && e[4] == 4)
+            candidate |= e[7] ? 0x80 : 0x40;
+        else if (e[6] == 5 && e[7] == textures && e[4] == 1)
+            ++textures;
+        else
+            return fail(why, "unsupported fixed-function declaration element");
+    }
+    candidate |= textures << 8;
+    D9FVF decoded;
+    if (!d9_fvf_decode(candidate, decoded, why))
+        return false;
+    if (decoded.declaration != declaration)
+        return fail(why, "fixed-function declaration offsets, order or terminator are unsupported");
+    fvf = candidate;
+    return true;
+}
+
+// Describes a vertex declaration directly, element by element, instead of
+// reconstructing an FVF code from it. The renderer already binds attributes to
+// shader inputs by usage, so the synthesized shader only needs to know which
+// attributes exist: a position, an optional normal, the two colours and how
+// many texture coordinate sets. That makes element order, offsets and the
+// stream number irrelevant, which is what a declaration with the positions in
+// a second stream needs, and it rejects vertex blending by name rather than as
+// an unrecognized element.
+bool d9_declaration_format(const std::vector<uint8_t> &declaration, D9FVF &format,
+                           std::string &why) {
+    if (declaration.size() < 16 || declaration.size() % 8)
+        return fail(why, "missing or truncated fixed-function declaration");
+    D9FVF f;
+    bool position = false, terminated = false;
+    for (size_t at = 0; at + 8 <= declaration.size(); at += 8) {
+        const uint8_t *e = declaration.data() + at;
+        if (e[4] == 17) { // D3DDECLTYPE_UNUSED marks the end
+            terminated = true;
+            break;
+        }
+        if (e[5]) // D3DDECLMETHOD: only DEFAULT is implemented
+            return fail(why, "vertex declaration method is not implemented: usage " +
+                             std::to_string(e[6]) + " index " + std::to_string(e[7]) +
+                             " method " + std::to_string(e[5]));
+        switch (e[6]) {
+        case 0: // POSITION
+            if (e[7] != 0)
+                return fail(why, "position usage index is not implemented: " +
+                                 std::to_string(e[7]));
+            position = true;
+            break;
+        case 9: // POSITIONT
+            position = true;
+            f.transformed = true;
+            break;
+        case 1: // BLENDWEIGHT
+        case 2: // BLENDINDICES
+            return fail(why, "fixed-function vertex blending is not implemented");
+        case 3: // NORMAL
+            f.normal = true;
+            break;
+        case 10: // COLOR
+            if (e[7] == 0)
+                f.diffuse = true;
+            else if (e[7] == 1)
+                f.specular = true;
+            else
+                return fail(why, "colour usage index is not implemented: " +
+                                 std::to_string(e[7]));
+            break;
+        case 5: // TEXCOORD
+            if (e[7] + 1 > f.textures)
+                f.textures = e[7] + 1;
+            break;
+        default:
+            return fail(why, "vertex declaration usage is not implemented: usage " +
+                             std::to_string(e[6]) + " index " + std::to_string(e[7]));
+        }
+    }
+    if (!terminated)
+        return fail(why, "fixed-function declaration has no terminator");
+    if (!position)
+        return fail(why, "fixed-function declaration has no position");
+    format = std::move(f);
+    why.clear();
+    return true;
+}
+
+// Pixel side of the fixed-function pipeline: one TEX per textured stage, the
+// COMBINE operations that follow, and the specular add. `uv_sets` is the number
+// of texture coordinate sets in the vertex layout, or zero when the application
+// supplies its own vertex shader and the layout is therefore unknown.
+bool pixel_stages(const D9Pipeline &p, uint32_t uv_sets, Code &vs, Code &ps,
+                  D9FixedFunction &out, bool vertex_supplied, std::string &why) {
+    declare(ps, R_INPUT, 0, 10);
+    declare(ps, R_INPUT, 1, 10, 1);
+    uint32_t one = 0x3f800000, two = 0x40000000, four = 0x40800000, half = 0x3f000000;
+    ps.op(OP_DEF, {dst(R_CONST, 1), one, two, four, half});
+    for (unsigned k = 0; k < 4; ++k)
+        out.pconst[0][k] = ((p.rs[60] >> (k == 3 ? 24 : (2 - k) * 8)) & 255) / 255.0f;
+    ps.op(OP_MOV, {dst(R_TEMP, 0), src(R_INPUT, 0)});
+    // Texture-coordinate transforms need a matrix per stage, taken from the
+    // first free constant past the lighting range and allocated only for the
+    // stages that ask for one.
+    unsigned tt_base = 18 + 16;
+    for (uint32_t stage = 0; stage < 8; ++stage) {
+        const uint32_t *t = p.tss[stage];
+        if (t[1] == 1 || (t[2] == 2 && !p.sampler_tex[stage]))
+            break;
+        // D3DTSS_TEXCOORDINDEX: the low three bits select a UV set, and the
+        // generator bits ask for a coordinate computed from the vertex instead.
+        // D3DTSS_TCI_PASSTHRU 0, CAMERASPACENORMAL 0x10000 and
+        // CAMERASPACEPOSITION 0x20000 are implemented; the reflection vector and
+        // sphere map generators are not.
+        uint32_t tci = t[11] & ~7u, uv_index = t[11] & 7u;
+        if (tci && tci != 0x10000u && tci != 0x20000u)
+            return fail(why, "texgen is not implemented: stage " + std::to_string(stage) +
+                             " texcoord index " + std::to_string(t[11]));
+        if (tci == 0x10000u && !out.format.normal)
+            return fail(why, "camera-space normal texgen needs a normal: stage " +
+                             std::to_string(stage));
+        if (t[28] && t[28] != 1)
+            return fail(why, "texture TEMP result is not implemented: stage " +
+                             std::to_string(stage) + " result arg " + std::to_string(t[28]));
+        // D3DTSS_TEXTURETRANSFORMFLAGS: 0 disables the transform, 1..4 give the
+        // number of components, and 0x100 asks for the projective divide that
+        // the renderer performs from the coordinate's w lane.
+        uint32_t ttf = t[24], count = ttf & 7, projected = ttf & 0x100;
+        if (ttf & ~0x107u)
+            return fail(why, "texture transform flags are not implemented: stage " +
+                             std::to_string(stage) + " flags " + std::to_string(ttf));
+        if (ttf && (count < 1 || count > 4))
+            return fail(why, "texture transform component count is not implemented: stage " +
+                             std::to_string(stage) + " flags " + std::to_string(ttf));
+        bool textured = false;
+        for (uint32_t type : {2u, 3u, 5u, 6u})
+            textured |= (t[type] & 15) == 2;
+        if (textured) {
+            if (!p.sampler_tex[stage])
+                return fail(why, "texture argument has no texture");
+            // The fixed-function vertex path produces the stage's coordinate. A
+            // supplied vertex shader already writes its own, and D3D applies no
+            // fixed-function transform to a programmable vertex pipeline.
+            if (!vertex_supplied) {
+                if (!ttf && !tci) {
+                    if (uv_index >= uv_sets)
+                        return fail(why, "texture argument has no texture or UV set");
+                    vs.op(OP_MOV, {dst(R_TEXCRDOUT, stage), src(R_INPUT, 3 + uv_index)});
+                } else if (!ttf) {
+                    // A generated coordinate with no transform is used as-is:
+                    // camera-space position or normal, so only the view matrix
+                    // applies.
+                    float vt[16];
+                    multiply(p.transform[2], p.transform[16 + stage], vt);
+                    for (uint32_t col = 0; col < 4; ++col)
+                        for (uint32_t row = 0; row < 4; ++row)
+                            out.vconst[tt_base + col][row] = vt[4 * row + col];
+                    for (uint32_t k = 0; k < 4; ++k)
+                        vs.op(OP_DP4, {dst(R_TEMP, 6, 1u << k),
+                                       src(R_INPUT, tci == 0x10000u ? 11 : 0),
+                                       src(R_CONST, tt_base + k)});
+                    vs.op(OP_MOV, {dst(R_TEXCRDOUT, stage), src(R_TEMP, 6)});
+                    tt_base += 4;
+                } else {
+                    // The stage's matrix, or the view matrix composed with it
+                    // for a generated coordinate, in the same row-vector
+                    // convention as the world matrix: c[col][row] = m[4*row+col].
+                    float mat[16];
+                    if (tci)
+                        multiply(p.transform[2], p.transform[16 + stage], mat);
+                    else
+                        memcpy(mat, p.transform[16 + stage], sizeof mat);
+                    for (uint32_t col = 0; col < 4; ++col)
+                        for (uint32_t row = 0; row < 4; ++row)
+                            out.vconst[tt_base + col][row] = mat[4 * row + col];
+                    if (tci) {
+                        vs.op(OP_MOV, {dst(R_TEMP, 5), src(R_INPUT, tci == 0x10000u ? 11 : 0)});
+                        if (tci == 0x10000u) // a normal has no translation term
+                            vs.op(OP_MOV, {dst(R_TEMP, 5, 8), src(R_CONST, 7, 0x00)});
+                    } else {
+                        // A plain UV set is (u, v, 0, 1), so the translation row
+                        // applies to it.
+                        if (uv_index >= uv_sets)
+                            return fail(why, "texture argument has no texture or UV set");
+                        vs.op(OP_MOV, {dst(R_TEMP, 5, 3), src(R_INPUT, 3 + uv_index)});
+                        vs.op(OP_MOV, {dst(R_TEMP, 5, 4), src(R_CONST, 7, 0x00)});
+                        vs.op(OP_MOV, {dst(R_TEMP, 5, 8), src(R_CONST, 4, 0x00)});
+                    }
+                    for (uint32_t k = 0; k < 4; ++k)
+                        vs.op(OP_DP4, {dst(R_TEMP, 6, 1u << k), src(R_TEMP, 5),
+                                       src(R_CONST, tt_base + k)});
+                    if (projected) {
+                        // The renderer divides by w, so the divisor goes there.
+                        uint32_t from = count < 4 ? count : 3;
+                        vs.op(OP_DP4, {dst(R_TEMP, 6, 8), src(R_TEMP, 5),
+                                       src(R_CONST, tt_base + from)});
+                    }
+                    vs.op(OP_MOV, {dst(R_TEXCRDOUT, stage), src(R_TEMP, 6)});
+                    tt_base += 4;
+                }
+            }
+            declare(ps, R_ADDR, stage, 5, stage);
+            ps.op(OP_DCL, {0x90000000u, dst(R_SAMPLER, stage)}); // 2D sampler
+            ps.op(OP_TEX, {dst(R_TEMP, 1), src(R_ADDR, stage), src(R_SAMPLER, stage)});
+        }
+        for (unsigned alpha = 0; alpha < 2; ++alpha) {
+            uint32_t a, b;
+            if (!argument(ps, t[alpha ? 5 : 2], 2, a, why) ||
+                !argument(ps, t[alpha ? 6 : 3], 3, b, why) ||
+                !combine(ps, t[alpha ? 4 : 1], a, b, alpha ? 8 : 7, why))
+                return false;
+        }
+        ps.op(OP_MOV, {dst(R_TEMP, 0), src(R_TEMP, 4)});
+    }
+    // D3D adds the vertex specular colour after the texture stages. With no
+    // specular element the vertex shader supplies c5, which stays zero.
+    if (p.rs[29])
+        ps.op(OP_ADD, {dst(R_TEMP, 0, 7), src(R_TEMP, 0), src(R_INPUT, 1)});
+    ps.op(OP_MOV, {dst(R_COLOROUT, 0), src(R_TEMP, 0)});
+    return true;
+}
+
+// Vertex side of the fixed-function pipeline: position transform, fog, lighting
+// and the colour outputs. `f` describes the vertex stream the application binds.
+bool vertex_program(const D9Pipeline &p, const D9FVF &f, uint32_t width, uint32_t height,
+                    Code &vs, D9FixedFunction &out, std::string &why) {
+    // Fixed-function lighting is a diffuse sum over the enabled lights plus
+    // the material's own ambient and emissive terms. It needs a normal; a
+    // format without one keeps its vertex colour and the lighting state is
+    // simply unused, which is what a prelit vertex stream expects.
+    bool lit = !f.transformed && p.rs[137] && f.normal;
+    // Table fog (D3DRS_FOGTABLEMODE) is evaluated per pixel by the renderer
+    // from the rasterizer depth and the fog colour. Per-vertex fog writes the
+    // factor below. Specular addition is folded into the pixel shader. Vertex
+    // blending changes the vertex stream layout, so it stays transactional.
+    if (p.rs[151] || p.rs[167])
+        return fail(why, "fixed-function vertex blending is not implemented");
+    // Flat (1) and gouraud (2) share this shader: the difference is purely
+    // how the raster stage interpolates the colour varyings, which the draw
+    // flags carry to the renderer (HostD9Draw.flat_colors). PHONG (3) has no
+    // implementation anywhere in the toolkit.
+    if (p.rs[9] != 2 && p.rs[9] != 1)
+        return fail(why, "fixed-function phong shading is not implemented");
+    vs.word(0xfffe0200u);
+    declare(vs, R_INPUT, 0, f.transformed ? 9 : 0);
+    if (f.diffuse)
+        declare(vs, R_INPUT, 1, 10);
+    if (f.specular)
+        declare(vs, R_INPUT, 2, 10, 1);
+    for (uint32_t i = 0; i < f.textures; ++i)
+        declare(vs, R_INPUT, 3 + i, 5, i);
+    // The normal gets the last free input slot, past the eight UV sets.
+    if (f.normal)
+        declare(vs, R_INPUT, 11, 3);
+    // c4 provides colour defaults; all position matrices occupy c0..c3.
+    out.vconst[4][0] = out.vconst[4][1] = out.vconst[4][2] = out.vconst[4][3] = 1;
+    // c7 holds the two literals the synthesized maths needs: zero (swizzle x)
+    // and -1 in every lane (swizzle y).
+    out.vconst[7][0] = 0.0f;
+    out.vconst[7][1] = -1.0f;
+    if (!f.transformed) {
+        float wv[16], wvp[16];
+        multiply(p.transform[24], p.transform[2], wv);
+        multiply(wv, p.transform[3], wvp);
+        // D3D matrices multiply row vectors; DP4 needs one column per constant.
+        for (unsigned col = 0; col < 4; ++col) {
+            for (unsigned row = 0; row < 4; ++row)
+                out.vconst[col][row] = wvp[4 * row + col];
+            vs.op(OP_DP4, {dst(R_RASTOUT, 0, 1u << col), src(R_INPUT, 0), src(R_CONST, col)});
+        }
+    } else {
+        float x = p.viewport_set ? (float)p.viewport[0] : 0;
+        float y = p.viewport_set ? (float)p.viewport[1] : 0;
+        float w = p.viewport_set ? (float)p.viewport[2] : (float)width;
+        float h = p.viewport_set ? (float)p.viewport[3] : (float)height;
+        float dz = p.viewport_z[1] - p.viewport_z[0];
+        if (!(w > 0 && h > 0 && dz > 0))
+            return fail(why, "invalid pretransformed viewport");
+        out.vconst[0][0] = 2 / w;
+        out.vconst[0][1] = -2 / h;
+        out.vconst[0][2] = 1 / dz;
+        out.vconst[1][0] = -1 - 2 * x / w;
+        out.vconst[1][1] = 1 + 2 * y / h;
+        out.vconst[1][2] = -p.viewport_z[0] / dz;
+        // Input w is reciprocal clip w. The renderers apply the DX9 pixel
+        // centre correction after this shader, exactly as for ordinary VSs.
+        vs.op(OP_RCP, {dst(R_TEMP, 0, 8), src(R_INPUT, 0, 0xff)});
+        vs.op(OP_MAD, {dst(R_TEMP, 0, 7), src(R_INPUT, 0), src(R_CONST, 0), src(R_CONST, 1)});
+        vs.op(OP_MUL, {dst(R_RASTOUT, 0, 7), src(R_TEMP, 0), src(R_TEMP, 0, 0xff)});
+        vs.op(OP_MOV, {dst(R_RASTOUT, 0, 8), src(R_TEMP, 0, 0xff)});
+    }
+    // D3DFOG_NONE/EXP/EXP2/LINEAR are 0/1/2/3. Table fog uses the
+    // rasterizer depth in the renderer, so only the vertex modes need a
+    // factor here. The renderer's mode 1 reads this oFog value; the table
+    // modes read the raster depth and ignore it.
+    if (p.rs[28] && !p.rs[35] && p.rs[140] >= 1 && p.rs[140] <= 3) {
+        if (!f.transformed)
+            vs.op(OP_DP4, {dst(R_TEMP, 0, 1), src(R_INPUT, 0), src(R_CONST, 3)});
+        else
+            vs.op(OP_MOV, {dst(R_TEMP, 0, 1), src(R_TEMP, 0, 0xff)});
+        if (p.rs[140] == 3) {
+            float start = 0, end = 1;
+            memcpy(&start, &p.rs[36], 4);
+            memcpy(&end, &p.rs[37], 4);
+            float inv = end != start ? 1.0f / (end - start) : 0.0f;
+            out.vconst[6][0] = end * inv;
+            out.vconst[6][1] = -inv;
+            // factor = z * (-inv) + end * inv, then saturate.
+            vs.op(OP_MAD, {dst(R_TEMP, 0, 1), src(R_TEMP, 0), src(R_CONST, 6, 0x55),
+                           src(R_CONST, 6)});
+        } else {
+            float density = 1;
+            memcpy(&density, &p.rs[38], 4);
+            out.vconst[6][0] = p.rs[140] == 2 ? density : -density;
+            vs.op(OP_MUL, {dst(R_TEMP, 0, 1), src(R_TEMP, 0), src(R_CONST, 6)});
+            if (p.rs[140] == 2) {
+                // EXP2: exp(-(density * z)^2).
+                out.vconst[6][1] = -1;
+                vs.op(OP_MUL, {dst(R_TEMP, 0, 1), src(R_TEMP, 0), src(R_TEMP, 0)});
+                vs.op(OP_MUL, {dst(R_TEMP, 0, 1), src(R_TEMP, 0), src(R_CONST, 6, 0x55)});
+            }
+            vs.op(OP_EXPP, {dst(R_TEMP, 0, 1), src(R_TEMP, 0)});
+        }
+        vs.op(OP_MOV, {dst(R_RASTOUT, 1, 1, true), src(R_TEMP, 0)});
+    }
+    if (lit) {
+        // Diffuse fixed-function lighting, per vertex:
+        //   colour = emissive + ambient * material.ambient
+        //          + sum over enabled lights of
+        //              light.diffuse * material.diffuse * max(0, N . L)
+        //          + vertex colour when D3DRS_COLORVERTEX is set.
+        // Directional lights use their direction as-is; point and spot lights
+        // use the vector from the light to the vertex, without attenuation,
+        // range or the spot cone. That keeps lit geometry shaded rather than
+        // flat black, and it is exact for the directional case GTA SA uses for
+        // its sun. The world matrix is c8..c11 so the normal can be rotated
+        // into world space, which is where the light vectors live.
+        const D9Material &m = p.material;
+        for (unsigned col = 0; col < 4; ++col)
+            for (unsigned row = 0; row < 4; ++row)
+                out.vconst[8 + col][row] = p.transform[24][4 * row + col];
+        // c16..c17: material diffuse, and emissive plus ambient scaled by the
+        // global ambient render state (D3DRS_AMBIENT is a D3DCOLOR: AABBGGRR).
+        memcpy(out.vconst[16], m.diffuse, sizeof m.diffuse);
+        uint32_t ambient = p.rs[139];
+        const float global[3] = {(float)(ambient & 0xff) / 255.0f,
+                                 (float)((ambient >> 8) & 0xff) / 255.0f,
+                                 (float)((ambient >> 16) & 0xff) / 255.0f};
+        for (unsigned k = 0; k < 3; ++k)
+            out.vconst[17][k] = m.emissive[k] + m.ambient[k] * global[k];
+        out.vconst[17][3] = 1.0f;
+        // Rotate the normal into world space and normalize it. Each DP3 writes
+        // one lane, so the masks are x, y and z.
+        vs.op(OP_DP3, {dst(R_TEMP, 3, 1), src(R_INPUT, 11), src(R_CONST, 8)});
+        vs.op(OP_DP3, {dst(R_TEMP, 3, 2), src(R_INPUT, 11), src(R_CONST, 9)});
+        vs.op(OP_DP3, {dst(R_TEMP, 3, 4), src(R_INPUT, 11), src(R_CONST, 10)});
+        vs.op(OP_NRM, {dst(R_TEMP, 3), src(R_TEMP, 3)});
+        // Start from the ambient and emissive terms.
+        vs.op(OP_MUL, {dst(R_TEMP, 0), src(R_CONST, 16), src(R_CONST, 17)});
+        // Point and spot lights need the vertex in world space, which is one
+        // DP4 whatever the number of lights. r2 keeps it for the whole loop so
+        // the per-light vector goes to r4 and the world position is not lost.
+        bool needs_world = false;
+        for (const D9Light &l : p.light)
+            needs_world |= l.enabled && (l.type == 1 || l.type == 2);
+        if (needs_world)
+            vs.op(OP_DP4, {dst(R_TEMP, 2), src(R_INPUT, 0), src(R_CONST, 8)});
+        unsigned used = 0;
+        for (unsigned i = 0; i < 8 && used < 8; ++i) {
+            const D9Light &l = p.light[i];
+            if (!l.enabled || l.type < 1 || l.type > 3)
+                continue;
+            unsigned base = 18 + used * 2;
+            ++used;
+            // c(base): light diffuse, c(base+1): world-space light vector.
+            memcpy(out.vconst[base], l.diffuse, sizeof l.diffuse);
+            // D3DLIGHT_POINT 1, D3DLIGHT_SPOT 2, D3DLIGHT_DIRECTIONAL 3.
+            bool directional = l.type == 3;
+            if (directional) {
+                // Directional: the vector points from the vertex towards the
+                // light, which is the negated direction.
+                for (unsigned k = 0; k < 3; ++k)
+                    out.vconst[base + 1][k] = -l.direction[k];
+                out.vconst[base + 1][3] = 0;
+            } else {
+                // Point and spot: the vector from the light to the vertex,
+                // which needs the vertex in world space. The position is
+                // stored negated with a w of one, so the MAD below yields
+                // world position minus light position.
+                for (unsigned k = 0; k < 3; ++k)
+                    out.vconst[base + 1][k] = -l.position[k];
+                out.vconst[base + 1][3] = 1;
+                vs.op(OP_MAD, {dst(R_TEMP, 4), src(R_CONST, base + 1), src(R_CONST, 4),
+                               src(R_TEMP, 2)});
+                vs.op(OP_NRM, {dst(R_TEMP, 4), src(R_TEMP, 4)});
+            }
+            if (directional) {
+                vs.op(OP_DP3, {dst(R_TEMP, 1), src(R_TEMP, 3), src(R_CONST, base + 1)});
+            } else {
+                // The light vector points away from the light, so the dot
+                // product with the surface normal is negated.
+                vs.op(OP_DP3, {dst(R_TEMP, 1), src(R_TEMP, 3), src(R_TEMP, 4)});
+                vs.op(OP_MUL, {dst(R_TEMP, 1), src(R_TEMP, 1), src(R_CONST, 7, 0x55)});
+            }
+            vs.op(OP_MAX, {dst(R_TEMP, 1), src(R_TEMP, 1), src(R_CONST, 7, 0x00)});
+            // light.diffuse * material.diffuse * max(0, N.L), accumulated.
+            vs.op(OP_MUL, {dst(R_TEMP, 4), src(R_CONST, base), src(R_CONST, 16)});
+            vs.op(OP_MAD, {dst(R_TEMP, 0), src(R_TEMP, 4), src(R_TEMP, 1), src(R_TEMP, 0)});
+        }
+        // The lit sum drives the colour; alpha keeps the material's, or the
+        // vertex's when COLORVERTEX is set, because D3D never lights alpha.
+        if (p.rs[141] && f.diffuse) {
+            vs.op(OP_MUL, {dst(R_TEMP, 0, 7), src(R_TEMP, 0), src(R_INPUT, 1)});
+            vs.op(OP_MOV, {dst(R_ATTROUT, 0, 7, true), src(R_TEMP, 0)});
+            vs.op(OP_MOV, {dst(R_ATTROUT, 0, 8), src(R_INPUT, 1, 0xff)});
+        } else {
+            vs.op(OP_MOV, {dst(R_ATTROUT, 0, 7, true), src(R_TEMP, 0)});
+            vs.op(OP_MOV, {dst(R_ATTROUT, 0, 8), src(R_CONST, 16, 0xff)});
+        }
+    } else {
+        vs.op(OP_MOV, {dst(R_ATTROUT, 0), f.diffuse ? src(R_INPUT, 1) : src(R_CONST, 4)});
+    }
+    vs.op(OP_MOV, {dst(R_ATTROUT, 1), f.specular ? src(R_INPUT, 2) : src(R_CONST, 5)});
+    return true;
+}
+
+bool d9_ffp_prepare(const D9Pipeline &p, uint32_t fvf, uint32_t width, uint32_t height,
+                    D9FixedFunction &result, std::string &why, bool vertex_supplied,
+                    bool pixel_supplied, const std::vector<uint8_t> *declaration) {
+    D9FixedFunction out;
+    if (!vertex_supplied) {
+        // A bound declaration describes the stream directly and is preferred:
+        // it carries element order, offsets and the stream number, which an FVF
+        // code cannot express.
+        bool described;
+        if (declaration && !declaration->empty())
+            described = d9_declaration_format(*declaration, out.format, why);
+        else if (fvf)
+            described = d9_fvf_decode(fvf, out.format, why);
+        else
+            described = fail(why, "no fixed-function vertex declaration or FVF is bound");
+        if (!described)
+            return false;
+    }
+    const D9FVF &f = out.format;
+    Code vs, ps;
+    if (!vertex_supplied && !vertex_program(p, f, width, height, vs, out, why))
+        return false;
+    if (!pixel_supplied) {
+        ps.word(0xffff0200u);
+        if (!pixel_stages(p, vertex_supplied ? 0 : f.textures, vs, ps, out, vertex_supplied,
+                          why))
+            return false;
+        out.ps = ps.finish();
+    }
+    if (!vertex_supplied)
+        out.vs = vs.finish();
+    // Only the synthesized half needs validating; a supplied one is the
+    // application's own bytecode, already checked when it was created.
+    if ((!vertex_supplied && !program_for(out.vs.vec()).ok) ||
+        (!pixel_supplied && !program_for(out.ps.vec()).ok))
+        return fail(why, "generated fixed-function shader failed bytecode validation");
+    result = std::move(out);
+    why.clear();
+    return true;
+}
diff --git a/dx/d3d9_ffp.h b/dx/d3d9_ffp.h
new file mode 100644
index 0000000..68ed040
--- /dev/null
+++ b/dx/d3d9_ffp.h
@@ -0,0 +1,62 @@
+// A bounded Direct3D 9 fixed-function shader synthesis path. Unsupported state
+// is rejected before either renderer sees a draw; the original device state
+// and its programmable shader constants are never changed by this helper.
+#pragma once
+#include "d3d9_pipeline.h"
+#include <array>
+
+struct D9FVF {
+    std::vector<uint8_t> declaration;
+    uint32_t stride = 0, textures = 0;
+    bool transformed = false, diffuse = false, specular = false, normal = false;
+};
+
+// One past the highest vertex-shader constant the synthesized pipeline writes:
+// c0..c3 world-view-projection, c4..c5 colour defaults, c6..c7 fog and the
+// shared literals, c8..c11 the world matrix, c16..c17 the material, c18..c33 up
+// to eight lights, and c34..c65 one four-column matrix per texture stage that
+// asks for a texture-coordinate transform. A draw swaps this range in and
+// restores the application's own constants afterwards.
+static constexpr unsigned D9_FFP_VCONST = 66;
+
+struct D9FixedFunction {
+    D9FVF format;
+    D9ShaderBytes vs, ps;
+    float vconst[D9_FFP_VCONST][4] = {};
+    float pconst[1][4] = {};
+};
+
+// XYZ/XYZRHW, optional normal and packed colours, and 0..8 float2 UV sets.
+// Vertex blending, point size, non-float2 UVs and reserved bits are rejected.
+bool d9_fvf_decode(uint32_t fvf, D9FVF &format, std::string &why);
+// Recognize only declarations exactly representable by the supported FVF
+// subset. Preserve original offsets/types; never guess or rearrange vertices.
+bool d9_declaration_fvf(const std::vector<uint8_t> &declaration, uint32_t &fvf, std::string &why);
+
+// Synthesizes SM2 shaders shared by the existing CPU and GPU renderers.
+// Supports unlit/prelit colour, diffuse fixed-function lighting from up to
+// eight lights, select/modulate/add/subtract texture stages, table and
+// per-vertex fog, and specular addition. Vertex blending, texgen, texture
+// transforms and spot/point attenuation are refused or approximated as noted
+// at their sites.
+//
+// D3D9 lets one half of the pipeline stay programmable while the other runs
+// fixed-function, and GTA SA relies on it: its skinned models bind their own
+// vertex shader and leave the pixel stages fixed. `vertex_supplied` and
+// `pixel_supplied` keep the application's half untouched and synthesize only
+// the missing one. The result's matching D9ShaderBytes member is then empty.
+//
+// `declaration`, when given and non-empty, is the bound vertex declaration and
+// takes precedence over `fvf`: it can describe element order, offsets and a
+// position in a second stream, none of which an FVF code carries.
+bool d9_ffp_prepare(const D9Pipeline &state, uint32_t fvf, uint32_t width, uint32_t height,
+                    D9FixedFunction &result, std::string &why, bool vertex_supplied = false,
+                    bool pixel_supplied = false,
+                    const std::vector<uint8_t> *declaration = nullptr);
+
+// Describes a vertex declaration directly: position, optional normal, the two
+// colours and the number of texture coordinate sets. Element order, offsets and
+// the stream number are irrelevant because the renderer binds attributes to
+// shader inputs by usage. Vertex blending is refused by name.
+bool d9_declaration_format(const std::vector<uint8_t> &declaration, D9FVF &format,
+                           std::string &why);
diff --git a/dx/tests/d3d9_ffp_tests.cpp b/dx/tests/d3d9_ffp_tests.cpp
new file mode 100644
index 0000000..c54635c
--- /dev/null
+++ b/dx/tests/d3d9_ffp_tests.cpp
@@ -0,0 +1,495 @@
+// Real SM2 decoder and software rasterizer tests, with owned COM surfaces.
+// No game image, generated code, GPU, window or pretend successful draw.
+#include "../com.h"
+#include "../dx.h"
+#include "../d3d9_ffp.h"
+#include "../d3d9_raster.h"
+#include "../d3d9_shader.h"
+#include "../d3d9_wgsl.h"
+#include "../../runtime/memory.h"
+#include "../../runtime/win32.h"
+#include <cstdio>
+#include <cstring>
+#include <initializer_list>
+
+namespace {
+unsigned checks = 0, failures = 0;
+void check(bool condition, const char *description) {
+    ++checks;
+    if (!condition) {
+        ++failures;
+        printf("FAIL: %s\n", description);
+    }
+}
+ComObj *surface(uint32_t width, uint32_t height) {
+    ComObj *s = com_new(K_D3D9SURFACE);
+    s->width = width;
+    s->height = height;
+    s->pitch = width * 4;
+    s->bpp = 32;
+    s->rmask = 21;
+    s->blob.resize((size_t)s->pitch * height);
+    return s;
+}
+uint32_t pixel(ComObj *s, uint32_t x, uint32_t y) {
+    uint32_t p;
+    memcpy(&p, s->blob.data() + y * s->pitch + 4 * x, 4);
+    return p;
+}
+void defaults(D9Pipeline &p) {
+    p = D9Pipeline{};
+    p.rs[137] = 0;
+    p.rs[22] = 1;
+    p.rs_set[22] = true;
+    for (auto &matrix : p.transform) {
+        memset(matrix, 0, sizeof matrix);
+        for (unsigned i = 0; i < 4; ++i)
+            matrix[5 * i] = 1;
+    }
+}
+bool draw(ComObj *dev, ComObj *target, uint32_t fvf, const void *vertices, size_t bytes) {
+    D9Pipeline &p = d9_pipeline(dev->id);
+    D9FixedFunction ff;
+    std::string why;
+    if (!d9_ffp_prepare(p, fvf, target->width, target->height, ff, why)) {
+        printf("prepare failed: %s\n", why.c_str());
+        return false;
+    }
+    check(d9sh::program_for(ff.vs.vec()).ok, "synthesized VS decodes");
+    check(d9sh::program_for(ff.ps.vec()).ok, "synthesized PS decodes");
+    std::string shader_source, shader_error;
+    check(d9wgsl::vertex_source(d9sh::program_for(ff.vs.vec()), &shader_source, &shader_error),
+          "synthesized VS translates through actual WebGPU shader generator");
+    check(d9wgsl::pixel_source(d9sh::program_for(ff.ps.vec()), {}, &shader_source, &shader_error),
+          "synthesized PS translates through actual WebGPU shader generator");
+    p.vs = ff.vs;
+    p.ps = ff.ps;
+    memcpy(p.vconst, ff.vconst, sizeof ff.vconst);
+    memcpy(p.pconst, ff.pconst, sizeof ff.pconst);
+    D9DrawCall call;
+    call.prim = 4;
+    call.prim_count = 1;
+    call.stride = ff.format.stride;
+    call.vertex_data = (const uint8_t *)vertices;
+    call.vertex_bytes = bytes;
+    call.flat_colors = p.rs[9] == 1; // the same wiring the device applies
+    d9_raster_draw(dev, target, ff.format.declaration, call);
+    return true;
+}
+struct XYZColour {
+    float x, y, z;
+    uint32_t colour;
+};
+struct XYZSpecular {
+    float x, y, z;
+    uint32_t colour, specular;
+};
+struct ScreenColour {
+    float x, y, z, rhw;
+    uint32_t colour;
+};
+struct TwoUV {
+    float x, y, z, nx, ny, nz;
+    uint32_t colour;
+    float u0, v0, u1, v1;
+};
+static_assert(sizeof(TwoUV) == 44, "FVF normal/diffuse/two UV layout");
+void raster_cases() {
+    ComObj *dev = com_new(K_D3D9DEVICE), *target = surface(64, 64);
+    D9Pipeline &p = d9_pipeline(dev->id);
+    defaults(p);
+    const XYZColour triangle[] = {{-.75f, .75f, .5f, 0xffff0000},
+                                  {.75f, .75f, .5f, 0xffff0000},
+                                  {-.75f, -.75f, .5f, 0xffff0000}};
+    check(draw(dev, target, 0x42, triangle, sizeof triangle), "prelit XYZ triangle accepted");
+    check(pixel(target, 12, 12) == 0xffff0000, "prelit vertex colour reaches raster pixels");
+    check(pixel(target, 60, 60) == 0, "outside triangle remains untouched");
+
+    defaults(p);
+    memset(target->blob.data(), 0, target->blob.size());
+    p.transform[24][0] = .5f;
+    p.transform[24][5] = .5f;
+    p.transform[2][12] = .25f;
+    p.transform[3][0] = .5f;
+    check(draw(dev, target, 0x42, triangle, sizeof triangle), "nonidentity WVP accepted");
+    check(pixel(target, 12, 12) == 0, "nonidentity WVP moves the original covered pixel");
+    check(pixel(target, 34, 23) == 0xffff0000, "world/view/projection compose in row-vector order");
+
+    defaults(p);
+    memset(target->blob.data(), 0, target->blob.size());
+    p.viewport_set = true;
+    p.viewport[0] = 16;
+    p.viewport[1] = 8;
+    p.viewport[2] = p.viewport[3] = 32;
+    p.viewport_z[0] = .2f;
+    p.viewport_z[1] = .8f;
+    // RHW != 1 verifies inverse viewport reconstruction and clip w.
+    const ScreenColour screen[] = {{20, 12, .5f, .5f, 0xff00ff00},
+                                   {40, 12, .5f, .5f, 0xff00ff00},
+                                   {20, 32, .5f, .5f, 0xff00ff00}};
+    p.rs[137] = 1; // transformed/lit input bypasses fixed-function lighting
+    check(draw(dev, target, 0x44, screen, sizeof screen), "XYZRHW bypasses lighting and WVP");
+    check(pixel(target, 22, 14) == 0xff00ff00,
+          "XYZRHW preserves screen placement in offset viewport");
+    check(pixel(target, 5, 5) == 0, "offset viewport leaves unrelated pixels untouched");
+
+    defaults(p);
+    memset(target->blob.data(), 0, target->blob.size());
+    ComObj *tex = surface(2, 1);
+    const uint32_t texels[] = {0xffff0000, 0x8000ff00};
+    memcpy(tex->blob.data(), texels, sizeof texels);
+    p.sampler_tex[0] = tex->id;
+    p.sampler_state[0][1] = 3; // clamp, so UV 1 selects the last texel
+    p.tss[0][11] = 1;          // select UV set 1, not UV set 0
+    const TwoUV textured[] = {{-.75f, .75f, .5f, 0, 0, 1, 0xff808080, 0, 0, 1, 0},
+                              {.75f, .75f, .5f, 0, 0, 1, 0xff808080, 0, 0, 1, 0},
+                              {-.75f, -.75f, .5f, 0, 0, 1, 0xff808080, 0, 0, 1, 0}};
+    check(draw(dev, target, 0x252, textured, sizeof textured),
+          "44-byte FVF textured triangle accepted");
+    check(pixel(target, 12, 12) == 0x80008000,
+          "UV set selection, modulate colour and independent alpha work");
+    p.tss[0][1] = 2; // select texture alpha replicated and complemented into RGB
+    p.tss[0][2] = 2 | 0x20 | 0x10;
+    p.tss[0][4] = 2;
+    p.tss[0][5] = 3; // texture factor alpha
+    p.rs[60] = 0x40000000;
+    memset(target->blob.data(), 0, target->blob.size());
+    check(draw(dev, target, 0x252, textured, sizeof textured),
+          "texture argument modifiers accepted");
+    check(pixel(target, 12, 12) == 0x407f7f7f,
+          "complement, alpha replication, factor and saturation reach real pixels");
+}
+void refusal_cases() {
+    D9FVF f;
+    std::string why;
+    check(d9_fvf_decode(0x252, f, why) && f.stride == 44,
+          "FVF stride includes normal/diffuse/two UV sets");
+    check(!d9_fvf_decode(0x14, f, why), "XYZRHW with normal rejected");
+    check(!d9_fvf_decode(0x46, f, why), "blended position rejected");
+    check(!d9_fvf_decode(0x10042, f, why), "unsupported UV dimensions rejected");
+    D9Pipeline p;
+    defaults(p);
+    D9FixedFunction ff;
+    ff.format.stride = 123; // rejected synthesis is transactional
+    p.rs[137] = 1;
+    check(!d9_ffp_prepare(p, 0x42, 64, 64, ff, why), "unimplemented XYZ lighting refused");
+    check(ff.format.stride == 123, "refusal leaves output unchanged");
+    p.rs[137] = 0;
+    p.rs[28] = 1;
+    p.rs[35] = 3; // D3DFOG_LINEAR table fog, applied by the renderer
+    check(d9_ffp_prepare(p, 0x42, 64, 64, ff, why), "linear table fog accepted");
+    p.rs[28] = 0;
+    p.rs[35] = 0;
+    p.rs[29] = 1;
+    check(d9_ffp_prepare(p, 0x42, 64, 64, ff, why), "specular addition accepted");
+    p.rs[29] = 0;
+    p.rs[151] = 1;
+    check(!d9_ffp_prepare(p, 0x42, 64, 64, ff, why), "vertex blending refused");
+    p.rs[151] = 0;
+    p.sampler_tex[0] = 1;
+    p.tss[0][11] = 0x10000;
+    check(!d9_ffp_prepare(p, 0x142, 64, 64, ff, why), "automatic texture coordinates refused");
+    p.tss[0][11] = 0;
+    p.tss[0][1] = 26;
+    check(!d9_ffp_prepare(p, 0x142, 64, 64, ff, why), "unsupported texture operation refused");
+}
+
+void fog_and_specular_cases() {
+    D9Pipeline p;
+    defaults(p);
+    D9FixedFunction ff;
+    std::string why;
+    p.rs[28] = 1;
+    p.rs[35] = 3; // D3DFOG_LINEAR table fog, evaluated by the renderer
+    check(d9_ffp_prepare(p, 0x42, 64, 64, ff, why), "linear table fog accepted");
+    p.rs[35] = 0;
+    p.rs[140] = 3; // D3DFOG_LINEAR vertex fog, evaluated by the synthesized VS
+    check(d9_ffp_prepare(p, 0x42, 64, 64, ff, why), "linear vertex fog accepted");
+    std::string source, error;
+    check(d9wgsl::vertex_source(d9sh::program_for(ff.vs.vec()), &source, &error),
+          "vertex-fog VS translates through actual WebGPU shader generator");
+    check(source.find("o.fog") != std::string::npos,
+          "vertex fog writes the rasterizer fog factor");
+    p.rs[140] = 0;
+    p.rs[28] = 0;
+
+    ComObj *dev = com_new(K_D3D9DEVICE), *target = surface(64, 64);
+    D9Pipeline &dp = d9_pipeline(dev->id);
+    defaults(dp);
+    dp.rs[29] = 1;
+    const XYZSpecular specular[] = {{-.75f, .75f, .5f, 0xffff0000, 0xff00ff00},
+                                    {.75f, .75f, .5f, 0xffff0000, 0xff00ff00},
+                                    {-.75f, -.75f, .5f, 0xffff0000, 0xff00ff00}};
+    check(draw(dev, target, 0xc2, specular, sizeof specular), "specular triangle accepted");
+    check(pixel(target, 12, 12) == 0xffffff00,
+          "specular colour is added to the texture stage result");
+}
+
+uint32_t device_call(uint32_t view, uint32_t slot, std::initializer_list<uint32_t> args) {
+    X86 c = {};
+    c.r[R_ESP] = 0x0effff00;
+    uint32_t before = c.r[R_ESP];
+    c.r[R_ESP] -= 4 * ((uint32_t)args.size() + 2);
+    wr32(c.r[R_ESP], 0x12345678);
+    wr32(c.r[R_ESP] + 4, view);
+    uint32_t index = 0;
+    for (uint32_t value : args)
+        wr32(c.r[R_ESP] + 8 + 4 * index++, value);
+    uint32_t entry = rd32(rd32(view) + 4 * slot);
+    check(imports_dispatch(&c, entry), "real COM vtable dispatches the device method");
+    check(c.r[R_ESP] == before && c.eip == 0x12345678,
+          "device stdcall restores stack and return PC");
+    return c.r[R_EAX];
+}
+void device_cases() {
+    ComObj *dev = com_new(K_D3D9DEVICE), *target = surface(64, 64);
+    dev->width = dev->height = 64;
+    dev->render_target = target->id;
+    uint32_t view = com_view(dev, IF_D3DDEVICE9);
+    D9Pipeline &p = d9_pipeline(dev->id);
+    defaults(p);
+    uint32_t out = heap_alloc(4, true, 4);
+    check(device_call(view, 89, {0x42}) == 0, "real SetFVF installs supported declaration");
+    uint32_t declaration = p.declaration;
+    check(com_get(declaration) && !com_get(declaration)->blob.empty(),
+          "SetFVF owns actual declaration bytes");
+    check(device_call(view, 90, {out}) == 0 && rd32(out) == 0x42,
+          "real GetFVF returns installed format");
+    check(device_call(view, 89, {0x46}) == 0x8876086c, "real SetFVF rejects unsupported position");
+    check(p.fvf == 0x42 && p.declaration == declaration,
+          "failed SetFVF preserves previous binding");
+    check(device_call(view, 89, {0x42}) == 0 && p.declaration == declaration,
+          "identical SetFVF reuses declaration");
+    uint32_t vertices = heap_alloc(3 * sizeof(XYZColour), false, 4);
+    const XYZColour triangle[] = {{-.75f, .75f, .5f, 0xff0000ff},
+                                  {.75f, .75f, .5f, 0xff0000ff},
+                                  {-.75f, -.75f, .5f, 0xff0000ff}};
+    memcpy(gm_ptr(vertices), triangle, sizeof triangle);
+    p.vconst[0][0] = 123;
+    p.pconst[0][0] = 456;
+    check(device_call(view, 83, {4, 1, vertices, sizeof(XYZColour)}) == 0,
+          "real DrawPrimitiveUP executes fixed function");
+    check(pixel(target, 12, 12) == 0xff0000ff, "COM fixed-function draw writes actual blue pixels");
+    uint32_t decl_input = heap_alloc(com_get(declaration)->blob.size(), false, 4);
+    memcpy(gm_ptr(decl_input), com_get(declaration)->blob.data(),
+           com_get(declaration)->blob.size());
+    check(device_call(view, 86, {decl_input, out}) == 0 && rd32(out),
+          "create explicit fixed-function vertex declaration");
+    uint32_t explicit_decl = rd32(out);
+    check(device_call(view, 87, {explicit_decl}) == 0 && p.fvf == 0,
+          "SetVertexDeclaration binds explicit layout and clears FVF");
+    memset(target->blob.data(), 0, target->blob.size());
+    check(device_call(view, 83, {4, 1, vertices, sizeof(XYZColour)}) == 0 &&
+              pixel(target, 12, 12) == 0xff0000ff,
+          "explicit declaration draws actual pixels without requiring SetFVF");
+    D9FVF transformed;
+    std::string declaration_error;
+    uint32_t inferred = 0;
+    check(d9_fvf_decode(0x144, transformed, declaration_error) &&
+              d9_declaration_fvf(transformed.declaration, inferred, declaration_error) &&
+              inferred == 0x144,
+          "recognize pretransformed coloured textured declaration");
+    transformed.declaration[2] = 4;
+    check(!d9_declaration_fvf(transformed.declaration, inferred, declaration_error),
+          "refuse padded layout instead of guessing vertex offsets");
+    check(p.vs.empty() && p.ps.empty() && p.vconst[0][0] == 123 && p.pconst[0][0] == 456,
+          "synthesized draw restores shader bindings and application constants");
+    memset(target->blob.data(), 0, target->blob.size());
+    p.rs[137] = 1;
+    check(device_call(view, 83, {4, 1, vertices, sizeof(XYZColour)}) == 0x8876086c,
+          "COM draw refuses lighting instead of reporting fake success");
+    check(pixel(target, 12, 12) == 0, "refused draw does not modify framebuffer");
+    p.vs.bytes = std::make_shared<const std::vector<uint8_t>>(4, 1);
+    p.ps.bytes = std::make_shared<const std::vector<uint8_t>>(4, 2);
+    check(device_call(view, 92, {0}) == 0 && p.vs.empty(),
+          "NULL vertex shader really unbinds programmable state");
+    check(device_call(view, 107, {0}) == 0 && p.ps.empty(),
+          "NULL pixel shader really unbinds programmable state");
+    check(device_call(view, 92, {1}) == 0x8876086c,
+          "unsupported shader object rejected instead of fake success");
+    const uint32_t ps[] = {0xffff0200, 0x05000051, 0xa00f0000, 0x0000ffff,
+                           0,          0,          0x3f800000, // END-like immediate is not END
+                           0x02000001, 0x800f0800, 0xa0e40000, 0x0000ffff};
+    uint32_t tokens = heap_alloc(sizeof ps, false, 4);
+    memcpy(gm_ptr(tokens), ps, sizeof ps);
+    check(device_call(view, 106, {tokens, out}) == 0 && rd32(out),
+          "CreatePixelShader returns a real COM shader");
+    uint32_t shader = rd32(out), length = heap_alloc(4, true, 4);
+    check(device_call(shader, 4, {0, length}) == 0 && rd32(length) == sizeof ps,
+          "GetFunction reports full shader including END-like immediate");
+    uint32_t copy = heap_alloc(sizeof ps, false, 4);
+    check(device_call(shader, 4, {copy, length}) == 0 && !memcmp(gm_ptr(copy), ps, sizeof ps),
+          "GetFunction preserves exact original tokens");
+    check(device_call(view, 107, {shader}) == 0 && p.ps.size() == sizeof ps,
+          "binding a created shader installs real pipeline bytecode");
+    ComObj *object = com_this(shader);
+    uint32_t id = object->id;
+    check(device_call(shader, 2, {}) == 1 && com_get(id),
+          "device retains a shader after application releases its reference");
+    check(device_call(view, 108, {out}) == 0 && rd32(out) == shader,
+          "GetPixelShader returns the bound COM shader with a reference");
+    device_call(shader, 2, {});
+    auto snapshot = p.ps;
+    check(device_call(view, 107, {0}) == 0 && !com_get(id) && snapshot.size() == sizeof ps,
+          "unbinding releases COM ownership while sealed bytecode survives");
+    wr32(tokens, 0xfffe0200);
+    wr32(out, 0xdeadbeef);
+    check(device_call(view, 106, {tokens, out}) == 0x8876086c && rd32(out) == 0,
+          "pixel creation refuses vertex bytecode and clears output");
+    const uint32_t comment[] = {0xffff0200, 0x0001fffe, 0x0000ffff, 0x0000ffff};
+    check(d9sh::bytecode_size((const uint8_t *)comment, sizeof comment) == sizeof comment,
+          "shader length skips END-like comment payload");
+    check(!d9sh::bytecode_size((const uint8_t *)ps, sizeof ps - 4),
+          "unterminated shader is refused");
+}
+
+void flat_shading_cases() {
+    // D3DRS_SHADEMODE flat: the fixed-function gate accepts it into the same
+    // shaders, the WebGPU translation only differs in the varying struct, and
+    // the CPU raster draws every triangle in the provoking (first) vertex's
+    // colour. D3DSHADE_PHONG (3) stays refused.
+    D9Pipeline p;
+    defaults(p);
+    D9FixedFunction ff;
+    std::string why;
+    p.rs[9] = 1;
+    check(d9_ffp_prepare(p, 0x42, 64, 64, ff, why), "flat shading accepted by the FFP gate");
+    std::string src, src_why;
+    const d9sh::Program vs = d9sh::program_for(ff.vs.vec());
+    check(d9wgsl::vertex_source(vs, &src, &src_why, true) &&
+              src.find("V2FF") != std::string::npos &&
+              src.find("@interpolate(flat) d0") != std::string::npos &&
+              src.find("@interpolate(flat) d1") != std::string::npos,
+          "flat VS translation declares both colour varyings flat");
+    check(d9wgsl::vertex_source(vs, &src, &src_why, false) &&
+              src.find("@interpolate(flat)") == std::string::npos,
+          "gouraud VS translation interpolates colours as before");
+    const d9sh::Program ps = d9sh::program_for(ff.ps.vec());
+    check(d9wgsl::pixel_source(ps, {}, &src, &src_why, true) &&
+              src.find("@interpolate(flat) d1") != std::string::npos,
+          "flat PS translation reads the same flat varyings");
+    p.rs[9] = 3;
+    check(!d9_ffp_prepare(p, 0x42, 64, 64, ff, why), "phong shading refused");
+    p.rs[9] = 2;
+    ComObj *dev = com_new(K_D3D9DEVICE), *target = surface(64, 64);
+    // draw() works on the device's live pipeline, so the render-state setup
+    // below (lighting off, shade mode) must write into it, not into the
+    // pipeline used only for the gate checks above.
+    D9Pipeline &dp = d9_pipeline(dev->id);
+    defaults(dp);
+    dp.rs[9] = 2;
+    const XYZColour tri[] = {{-.75f, .75f, .5f, 0xffff0000},
+                             {.75f, .75f, .5f, 0xff00ff00},
+                             {-.75f, -.75f, .5f, 0xff0000ff}};
+    check(draw(dev, target, 0x42, tri, sizeof tri), "gouraud tri-coloured triangle accepted");
+    check(pixel(target, 12, 12) != 0xffff0000, "gouraud interior mixes the vertex colours");
+    defaults(dp);
+    dp.rs[9] = 1;
+    memset(target->blob.data(), 0, target->blob.size());
+    check(draw(dev, target, 0x42, tri, sizeof tri), "flat tri-coloured triangle accepted");
+    check(pixel(target, 12, 12) == 0xffff0000,
+          "flat raster paints the provoking vertex's colour everywhere covered");
+    check(pixel(target, 30, 30) == 0xffff0000, "flat colour reaches near the opposite edge");
+}
+
+uint32_t named_call(const char *dll, const char *name, std::initializer_list<uint32_t> args) {
+    X86 c = {};
+    c.r[R_ESP] = 0x0efff000;
+    wr32(c.r[R_ESP], 0x12345678);
+    uint32_t index = 1;
+    for (uint32_t value : args)
+        wr32(c.r[R_ESP] + 4 * index++, value);
+    uint32_t entry = imports_alloc_trampoline(dll, name, nullptr, 0);
+    check(imports_dispatch(&c, entry), "registered import dispatches");
+    return c.r[R_EAX];
+}
+
+void exclusive_client_area() {
+    uint32_t cls = heap_alloc(7, true, 1);
+    memcpy(gm_ptr(cls), "STATIC", 7);
+    uint32_t hwnd =
+        named_call("USER32.dll", "CreateWindowExA", {0, cls, cls, 0, 0, 0, 320, 240, 0, 0, 0, 0});
+    check(hwnd != 0, "synthetic window exists for swap-chain geometry test");
+    ComObj *factory = com_new(K_D3D9);
+    uint32_t view = com_view(factory, IF_D3D9);
+    uint32_t present = heap_alloc(56, true, 4), out = heap_alloc(4, true, 4);
+    wr32(present, 800);
+    wr32(present + 4, 600);
+    wr32(present + 8, 22);
+    check(device_call(view, 16, {0, 1, hwnd, 0, present, out}) == 0 && rd32(out),
+          "CreateDevice supports focus-window fallback for exclusive mode");
+    uint32_t device = rd32(out), rect = heap_alloc(16, true, 4);
+    named_call("USER32.dll", "GetClientRect", {hwnd, rect});
+    check(rd32(rect + 8) == 800 && rd32(rect + 12) == 600,
+          "exclusive client rect matches camera/back-buffer dimensions");
+    wr32(present + 32, 1);
+    check(device_call(device, 16, {present}) == 0, "Reset returns to windowed mode");
+    named_call("USER32.dll", "GetClientRect", {hwnd, rect});
+    check(rd32(rect + 8) == 320 && rd32(rect + 12) == 240,
+          "leaving exclusive mode restores original client geometry");
+    device_call(device, 2, {});
+    named_call("USER32.dll", "DestroyWindow", {hwnd});
+}
+
+// Independent handwritten passthrough shader bytes cover the global DX9
+// pixel-centre correction for existing programmable draws, not just FFP.
+void programmable_pixel_centres() {
+    const uint32_t vertex[] = {0xfffe0200, 0x0200001f, 0x80000000, 0x900f0000, 0x0200001f,
+                               0x8000000a, 0x900f0001, 0x02000001, 0xc00f0000, 0x90e40000,
+                               0x02000001, 0xd00f0000, 0x90e40001, 0x0000ffff};
+    const uint32_t pixel_shader[] = {0xffff0200, 0x0200001f, 0x8000000a, 0x900f0000,
+                                     0x02000001, 0x800f0800, 0x90e40000, 0x0000ffff};
+    ComObj *dev = com_new(K_D3D9DEVICE), *target = surface(64, 64);
+    D9Pipeline &p = d9_pipeline(dev->id);
+    defaults(p);
+    uint32_t view = com_view(dev, IF_D3DDEVICE9), out = heap_alloc(4, true, 4);
+    uint32_t input = heap_alloc(sizeof vertex, false, 4);
+    memcpy(gm_ptr(input), vertex, sizeof vertex);
+    check(device_call(view, 91, {input, out}) == 0 && rd32(out),
+          "create programmable vertex shader through COM");
+    uint32_t vs = rd32(out);
+    check(device_call(view, 92, {vs}) == 0, "bind programmable vertex shader through COM");
+    memcpy(gm_ptr(input), pixel_shader, sizeof pixel_shader);
+    check(device_call(view, 106, {input, out}) == 0 && rd32(out),
+          "create programmable pixel shader through COM");
+    uint32_t ps = rd32(out);
+    check(device_call(view, 107, {ps}) == 0, "bind programmable pixel shader through COM");
+    // The application may free its input tokens and references before drawing.
+    memset(gm_ptr(input), 0, sizeof vertex);
+    device_call(vs, 2, {});
+    device_call(ps, 2, {});
+    D9FVF f;
+    std::string why;
+    check(d9_fvf_decode(0x42, f, why), "programmable fixture has valid vertex declaration");
+    check(d9sh::program_for(p.vs.vec()).ok && d9sh::program_for(p.ps.vec()).ok,
+          "independent programmable passthrough shaders decode");
+    const XYZColour triangle[] = {{-.7375f, .7375f, .5f, 0xffff0000},
+                                  {-.2375f, .7375f, .5f, 0xffff0000},
+                                  {-.7375f, .2375f, .5f, 0xffff0000}};
+    D9DrawCall call;
+    call.prim = 4;
+    call.prim_count = 1;
+    call.stride = sizeof(XYZColour);
+    call.vertex_data = (const uint8_t *)triangle;
+    call.vertex_bytes = sizeof triangle;
+    d9_raster_draw(dev, target, f.declaration, call);
+    check(pixel(target, 8, 10) == 0, "programmable triangle honours DX9 integer pixel centres");
+    check(pixel(target, 9, 10) == 0xffff0000, "programmable triangle retains next interior pixel");
+    device_call(view, 2, {});
+}
+} // namespace
+
+int main() {
+    mem_init();
+    imports_init();
+    dx_register_shims();
+    raster_cases();
+    refusal_cases();
+    fog_and_specular_cases();
+    flat_shading_cases();
+    device_cases();
+    exclusive_client_area();
+    programmable_pixel_centres();
+    printf("d3d9 fixed function: %u checks, %u failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
diff --git a/runtime/perf_stats.h b/runtime/perf_stats.h
new file mode 100644
index 0000000..62dbcc2
--- /dev/null
+++ b/runtime/perf_stats.h
@@ -0,0 +1,187 @@
+// perf_stats.h - opt-in counters that attribute wall time to the runtime.
+//
+// A browser profile of the guest thread shows its cost split between
+// translated game code and the cooperative scheduler. These counters separate
+// the two without a sampling profiler: how many times the scheduler hands the
+// baton over, how many SEH frames each resumption scan walks, and how many
+// translated dispatches happen. Off unless RECOMP_PERF_STATS=1, and the
+// increments are plain integer adds so the measurement does not become the
+// cost being measured.
+#pragma once
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include "../platform/os.h"
+
+namespace perf_stats {
+
+inline bool on() {
+    static const bool value = [] {
+        const char *v = recomp_env("PERF_STATS");
+        return v && v[0] == '1' && v[1] == '\0';
+    }();
+    return value;
+}
+
+inline uint64_t handoffs = 0;          // baton moves, any reason
+inline uint64_t seh_resume_calls = 0;  // recomp_seh_resume_frame entries
+inline uint64_t seh_resume_frames = 0; // frames examined by those calls
+inline uint64_t seh_chain_visits = 0;  // guest SEH links validated
+inline uint64_t seh_boundary_calls = 0;
+inline uint64_t seh_boundary_frames = 0;
+inline uint64_t seh_live_frames = 0; // high-water mark of state.frames
+inline uint64_t callback_depth_calls = 0;
+inline uint64_t prune_passes = 0;  // prune_unlinked_frames runs
+inline uint64_t pruned_frames = 0; // frames retired by those runs
+
+// Why the baton moves, so a handoff rate can be attributed to the path that
+// causes it instead of only being counted.
+constexpr int HANDOFF_REASONS = 12;
+struct HandoffReason {
+    const char *why;
+    uint64_t count;
+};
+inline HandoffReason handoff_reasons[HANDOFF_REASONS] = {};
+
+inline void note_handoff(const char *why) {
+    if (!on())
+        return;
+    ++handoffs;
+    for (int i = 0; i < HANDOFF_REASONS; ++i) {
+        if (handoff_reasons[i].why && std::strcmp(handoff_reasons[i].why, why) == 0) {
+            ++handoff_reasons[i].count;
+            return;
+        }
+        if (!handoff_reasons[i].why) {
+            handoff_reasons[i].why = why;
+            handoff_reasons[i].count = 1;
+            return;
+        }
+    }
+}
+
+// Wall time the scheduler spent waiting on its condition variable. A frame time
+// made of slices shows up here as a large fraction of the elapsed window.
+inline double wait_seconds = 0;
+inline uint64_t wait_calls = 0;
+
+// How much traffic crosses the wasm/JS boundary and the guest dispatcher. A
+// frame whose cost is glue rather than game code shows up as a large count
+// here, which says whether the boundary is the thing to attack.
+inline uint64_t clock_reads = 0;
+inline uint64_t import_calls = 0;
+inline uint64_t dispatch_calls = 0;
+inline uint64_t printf_calls = 0;
+
+inline void note_wait(double seconds) {
+    if (!on())
+        return;
+    ++wait_calls;
+    wait_seconds += seconds;
+}
+
+// Where the SEH frames come from: one slot per establishing EIP, so a frame
+// list that only grows can be attributed to the guest function that installs
+// them instead of guessed at.
+constexpr int FRAME_SITES = 48;
+struct FrameSite {
+    uint32_t eip;
+    uint64_t count;
+};
+inline FrameSite frame_sites[FRAME_SITES] = {};
+inline uint64_t frame_enters = 0;
+inline uint64_t frames_now = 0;
+
+inline void note_frame_enter(uint32_t eip) {
+    if (!on())
+        return;
+    ++frame_enters;
+    for (int i = 0; i < FRAME_SITES; ++i) {
+        if (frame_sites[i].eip == eip) {
+            ++frame_sites[i].count;
+            return;
+        }
+        if (frame_sites[i].eip == 0) {
+            frame_sites[i].eip = eip ? eip : 1;
+            frame_sites[i].count = 1;
+            return;
+        }
+    }
+}
+
+struct Sample {
+    uint64_t handoffs, seh_resume_calls, seh_resume_frames, seh_chain_visits;
+    uint64_t seh_boundary_calls, seh_boundary_frames, callback_depth_calls, seh_live_frames;
+    uint64_t prune_passes, pruned_frames;
+    uint64_t clock_reads, import_calls, printf_calls;
+    double wait_seconds;
+};
+
+inline Sample &last() {
+    static Sample s{};
+    return s;
+}
+
+inline double &last_ns() {
+    static double ns = 0;
+    return ns;
+}
+
+// Prints a delta line at most every two seconds. Called from the scheduler
+// checkpoint, which already runs at most once per millisecond.
+inline void report() {
+    if (!on())
+        return;
+    const double now = (double)os_monotonic_ns();
+    double &previous_ns = last_ns();
+    if (previous_ns != 0 && now - previous_ns < 2e9)
+        return;
+    Sample &p = last();
+    if (previous_ns != 0) {
+        const double seconds = (now - previous_ns) / 1e9;
+        const Sample cur{
+            handoffs,           seh_resume_calls,    seh_resume_frames,    seh_chain_visits,
+            seh_boundary_calls, seh_boundary_frames, callback_depth_calls, seh_live_frames,
+            prune_passes,       pruned_frames,       clock_reads,          import_calls,
+            printf_calls,       wait_seconds};
+        auto rate = [seconds](uint64_t a, uint64_t b) {
+            return seconds > 0 ? double(a - b) / seconds : 0.0;
+        };
+        fprintf(stderr,
+                "perf: %.1fs handoffs=%.0f/s seh_resume=%.0f/s seh_frames=%.0f/s "
+                "chain_visits=%.0f/s seh_boundary=%.0f/s boundary_frames=%.0f/s "
+                "cb_depth=%.0f/s live_frames_max=%llu wait=%.0f%% prune=%llu/%llu "
+                "clock=%.0f/s imports=%.0f/s printf=%.0f/s\n",
+                seconds, rate(cur.handoffs, p.handoffs),
+                rate(cur.seh_resume_calls, p.seh_resume_calls),
+                rate(cur.seh_resume_frames, p.seh_resume_frames),
+                rate(cur.seh_chain_visits, p.seh_chain_visits),
+                rate(cur.seh_boundary_calls, p.seh_boundary_calls),
+                rate(cur.seh_boundary_frames, p.seh_boundary_frames),
+                rate(cur.callback_depth_calls, p.callback_depth_calls),
+                (unsigned long long)cur.seh_live_frames,
+                100.0 * (cur.wait_seconds - p.wait_seconds) / (seconds > 0 ? seconds : 1),
+                (unsigned long long)(cur.pruned_frames - p.pruned_frames),
+                (unsigned long long)(cur.prune_passes - p.prune_passes),
+                rate(cur.clock_reads, p.clock_reads), rate(cur.import_calls, p.import_calls),
+                rate(cur.printf_calls, p.printf_calls));
+        // Name the guest functions that keep installing SEH frames, so growth
+        // of the frame list can be traced to a site rather than to a guess.
+        static int reports = 0;
+        if (++reports % 5 == 0) {
+            for (int i = 0; i < FRAME_SITES && frame_sites[i].eip; ++i)
+                fprintf(stderr, "perf-frame: %08x enters=%llu\n", frame_sites[i].eip,
+                        (unsigned long long)frame_sites[i].count);
+            for (int i = 0; i < HANDOFF_REASONS && handoff_reasons[i].why; ++i)
+                fprintf(stderr, "perf-handoff: %s count=%llu\n", handoff_reasons[i].why,
+                        (unsigned long long)handoff_reasons[i].count);
+        }
+        fprintf(stderr, "perf-frames: live=%llu enters_total=%llu\n",
+                (unsigned long long)frames_now, (unsigned long long)frame_enters);
+        p = cur;
+    }
+    previous_ns = now;
+}
+
+} // namespace perf_stats
diff --git a/runtime/tests/game_boot_probe.cpp b/runtime/tests/game_boot_probe.cpp
new file mode 100644
index 0000000..6e2b4ea
--- /dev/null
+++ b/runtime/tests/game_boot_probe.cpp
@@ -0,0 +1,341 @@
+// A real PE startup probe: same verified loader, imports, scheduler and generated
+// CPU code as the player, with a null graphics/audio host. No gameplay proof.
+#include "loader.h"
+#include "imports.h"
+#include "interp.h"
+#include "memory.h"
+#include "win32.h"
+#include "../dx/dx.h"
+#include "../kernel32_internal.h"
+#include "../platform/os.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <atomic>
+#include <string>
+
+namespace {
+// Check real PE import descriptors before executing guest code. Every import
+// from a mapped module must point at its export, never an OS-shim trampoline.
+bool verify_mapped_imports(const LoaderModule &image) {
+    uint32_t opt = image.base + rd32(image.base + 0x3c) + 24;
+    uint32_t imports = rd32(opt + 104), count = 0;
+    for (uint32_t d = image.base + imports; imports && rd32(d + 12); d += 20) {
+        std::string name = gm_str(image.base + rd32(d + 12));
+        const LoaderModule *dependency = loader_module_named(name.c_str());
+        if (!dependency)
+            continue;
+        uint32_t original = rd32(d), iat = rd32(d + 16);
+        if (!original) {
+            fprintf(stderr, "[boot-probe] cannot independently verify bound-only imports\n");
+            return false;
+        }
+        for (uint32_t n = 0; rd32(image.base + original + 4 * n); ++n) {
+            uint32_t t = rd32(image.base + original + 4 * n);
+            uint32_t expected =
+                (t & 0x80000000u)
+                    ? loader_module_export_ordinal(*dependency, t & 0xffff)
+                    : loader_module_export(*dependency, gm_str(image.base + t + 2).c_str());
+            uint32_t slot = image.base + iat + 4 * n;
+            if (!expected || rd32(slot) != expected ||
+                (!image.initial_image.empty() &&
+                 memcmp(image.initial_image.data() + slot - image.base, g_mem + slot, 4))) {
+                fprintf(stderr, "[boot-probe] incorrect mapped import: %s -> %s\n",
+                        image.name.c_str(), name.c_str());
+                return false;
+            }
+            ++count;
+        }
+    }
+    fprintf(stderr, "[boot-probe] %s: %u mapped imports and reload snapshot verified\n",
+            image.name.c_str(), count);
+    return true;
+}
+
+// Exercise primary-buffer listener ownership through the returned original DLL
+// vtables, not a host object fabricated by the test. Scratch is guest memory.
+bool probe_sound_listener(X86 *c, uint32_t device, uint32_t scratch) {
+    const uint8_t iid[16] = {0x84, 0xfa, 0x9a, 0x27, 0x81, 0x49, 0xce, 0x11,
+                             0xa5, 0x21, 0x00, 0x20, 0xaf, 0x0b, 0xe5, 0x60};
+    memset(g_mem + scratch, 0, 192);
+    uint32_t out = scratch + 40, guid = scratch + 48, params = scratch + 64;
+    memcpy(g_mem + guid, iid, 16);
+    wr32(scratch, 36);     // DSBUFFERDESC
+    wr32(scratch + 4, 17); // PRIMARYBUFFER | CTRL3D
+    uint32_t hr = guest_call(c, rd32(rd32(device) + 12), device, scratch, out, 0);
+    uint32_t primary = rd32(out), listener = 0;
+    bool ok = hr == 0 && primary && gm_valid(primary, 4);
+    if (ok) {
+        hr = guest_call(c, rd32(rd32(primary)), primary, guid, out);
+        listener = rd32(out);
+        ok = hr == 0 && listener && gm_valid(listener, 4);
+        guest_call(c, rd32(rd32(primary) + 8), primary);
+    }
+    // The queried listener reference must keep the buffer alive after Release.
+    if (ok) {
+        wr32(params, 64);
+        wr32(params + 64, 0x13579bdf);
+        hr = guest_call(c, rd32(rd32(listener) + 12), listener, params);
+        ok = hr == 0 && rd32(params + 64) == 0x13579bdf;
+        if (ok)
+            ok = guest_call(c, rd32(rd32(listener) + 40), listener, params, 0) == 0;
+        guest_call(c, rd32(rd32(listener) + 8), listener);
+    }
+    fprintf(stderr, "[boot-probe] original primary listener: %s hr=%08x\n", ok ? "PASS" : "FAIL",
+            hr);
+    return ok;
+}
+
+// Optional focused reproduction of a three-argument DirectSound factory,
+// GetCaps and primary listener calls, using the actual translated DLL.
+int probe_sound_factory(const char *module, const char *name) {
+    const LoaderModule *m = loader_module_named(module);
+    uint32_t fn = m ? loader_module_export(*m, name) : 0;
+    if (!fn)
+        return 2;
+    X86 *c = loader_context();
+    uint32_t saved_esp = c->r[R_ESP], out = saved_esp - 512, caps = out + 16;
+    memset(g_mem + out, 0, 128);
+    wr32(caps, 96);
+    c->r[R_ESP] = out - 16;
+    uint32_t before = c->r[R_ESP];
+    sched_set_guest_thread(true);
+    uint32_t hr = guest_call(c, fn, 0, out, 0), object = rd32(out);
+    bool ok = !(hr & 0x80000000u) && object && gm_valid(object, 4) && c->r[R_ESP] == before;
+    fprintf(stderr, "[boot-probe] factory %s!%s: hr=%08x object=%08x stack=%s\n", module, name, hr,
+            object, c->r[R_ESP] == before ? "preserved" : "BAD");
+    if (ok) {
+        uint32_t table = rd32(object);
+        ok = gm_valid(table, 20) && rd32(table + 16);
+        if (ok) {
+            hr = guest_call(c, rd32(table + 16), object, caps);
+            ok = !(hr & 0x80000000u) && c->r[R_ESP] == before;
+            fprintf(stderr, "[boot-probe] original factory GetCaps: hr=%08x stack=%s\n", hr,
+                    c->r[R_ESP] == before ? "preserved" : "BAD");
+            if (ok)
+                ok = probe_sound_listener(c, object, out + 128) && c->r[R_ESP] == before;
+            guest_call(c, rd32(table + 8), object);
+        }
+    }
+    sched_set_guest_thread(false);
+    c->r[R_ESP] = saved_esp;
+    return ok ? 0 : 1;
+}
+
+bool write_region(const std::string &path, uint32_t base, uint32_t size) {
+    if (base >= GUEST_SIZE || size > GUEST_SIZE - base)
+        return false;
+    FILE *out = fopen(path.c_str(), "wb");
+    if (!out) {
+        fprintf(stderr, "[boot-probe] cannot open dump %s\n", path.c_str());
+        return false;
+    }
+    bool ok = fwrite(g_mem + base, 1, size, out) == size;
+    ok = fclose(out) == 0 && ok;
+    return ok;
+}
+
+// ----------------------------------------------------------------------------
+// Spin watchdog. A guest loop that keeps dispatching shims forever looks
+// healthy to every runtime check: each call returns, no strict policy fires,
+// and the bootlog only shows the same import triplet repeated. When
+// PROBE_WATCHDOG names a TlsGetValue call count, this observer counts
+// dispatches of that shim and, at the threshold, prints a live thread dump
+// and writes a snapshot of the loaded image, stack, TEB, TLS and low heap.
+// The observer contract forbids touching the guest context, so the snapshot
+// is read-only: every write here goes to stderr or to files.
+std::atomic<uint32_t> g_watch_calls{0};
+std::atomic<uint32_t> g_watch_target{0};
+std::atomic<uint32_t> g_watch_cs_pairs{0};
+std::atomic<uint32_t> g_watch_cs_target{0};
+std::atomic<uint32_t> g_watch_cs{0};
+std::string g_watch_prefix = "boot_probe_dump";
+const char *g_watch_last_desc = "none";
+
+void watchdog_fire() {
+    fprintf(stderr,
+            "[boot-probe] spin watchdog: %u TlsGetValue calls, %u critsec pairs, last shim %s, "
+            "last critsec=%08x\n",
+            g_watch_calls.load(), g_watch_cs_pairs.load(), g_watch_last_desc, g_watch_cs.load());
+    kernel32_dump_threads();
+    FILE *info = fopen((g_watch_prefix + ".json").c_str(), "wb");
+    if (info) {
+        fprintf(info,
+                "{\"tls_calls\":%u,\"critsec_pairs\":%u,\"last_shim\":\"%s\",\"critsec\":%u}\n",
+                g_watch_calls.load(), g_watch_cs_pairs.load(), g_watch_last_desc,
+                g_watch_cs.load());
+        fclose(info);
+    }
+    write_region(g_watch_prefix + ".image.bin", loader_image_base(), loader_image_size());
+    write_region(g_watch_prefix + ".stack.bin", STACK_LIMIT, STACK_SIZE);
+    write_region(g_watch_prefix + ".teb.bin", TEB_BASE, TEB_SIZE + 0x1000u); // TEB + TLS slots
+    write_region(g_watch_prefix + ".heap.bin", HEAP_BASE, 0x1000000u);      // low heap arena
+    for (uint32_t i = 0; i < loader_module_count(); ++i) {
+        const LoaderModule *m = loader_module(i);
+        if (m)
+            write_region(g_watch_prefix + ".aux" + std::to_string(i) + ".bin", m->base, m->size);
+    }
+    fprintf(stderr, "[boot-probe] snapshot written with prefix %s; exiting\n",
+            g_watch_prefix.c_str());
+    fflush(stderr);
+    exit(3);
+}
+
+bool spin_watchdog(const char *desc, const uint32_t *args, uint32_t argc, uint32_t *result) {
+    (void)result;
+    (void)args;
+    (void)argc;
+    if (strstr(desc, "CriticalSection")) {
+        if ((strstr(desc, "TryEnter") || strstr(desc, "!Enter")) && args)
+            g_watch_cs.store(args[0]);
+        uint32_t pairs = g_watch_cs_pairs.fetch_add(1) + 1;
+        if (g_watch_cs_target.load() && pairs == g_watch_cs_target.load()) {
+            watchdog_fire();
+            return true;
+        }
+    } else if (strstr(desc, "!TlsGetValue")) {
+        g_watch_last_desc = desc;
+        uint32_t seen = g_watch_calls.fetch_add(1) + 1;
+        if (g_watch_target.load() && seen == g_watch_target.load()) {
+            watchdog_fire();
+            return true;
+        }
+    }
+    return true;
+}
+} // namespace
+
+// Runs before strict abort while the guest baton holder owns these bytes. A
+// supplied prefix enables snapshots; absence leaves no diagnostic files. Each
+// binary starts at its reported guest base, not a host address or file offset.
+extern "C" void recomp_unknown_diagnostic(X86 *c, uint32_t target) {
+    const char *prefix = recomp_env("PROBE_DUMP");
+    if (!prefix || !*prefix)
+        return;
+    std::string root(prefix);
+    FILE *out = fopen((root + ".json").c_str(), "wb");
+    if (!out) {
+        fprintf(stderr, "[boot-probe] cannot open dump manifest\n");
+        return;
+    }
+    fprintf(out, "{\"target\":%u,\"eip\":%u,\"registers\":[", target, c->eip);
+    for (unsigned i = 0; i < 8; ++i)
+        fprintf(out, "%s%u", i ? "," : "", c->r[i]);
+    fprintf(out, "],\"eflags\":%u,\"fs_base\":%u,\"exe_sha256\":\"%s\",\"regions\":[",
+            x86_get_eflags(c), c->fs_base, loader_exe_sha256());
+    auto region = [&](const std::string &suffix, uint32_t base, uint32_t size, bool first) {
+        bool ok = write_region(root + suffix, base, size);
+        fprintf(out, "%s{\"suffix\":\"%s\",\"base\":%u,\"size\":%u,\"written\":%s}",
+                first ? "" : ",", suffix.c_str(), base, size, ok ? "true" : "false");
+    };
+    region(".image.bin", loader_image_base(), loader_image_size(), true);
+    region(".stack.bin", STACK_LIMIT, STACK_SIZE, false);
+    region(".teb.bin", TEB_BASE, TEB_SIZE, false);
+    for (uint32_t i = 0; i < loader_module_count(); ++i) {
+        const LoaderModule *m = loader_module(i);
+        if (m)
+            region(".aux" + std::to_string(i) + ".bin", m->base, m->size, false);
+    }
+    fprintf(out, "]}\n");
+    fclose(out);
+    fprintf(stderr, "[boot-probe] guest snapshots written with prefix %s\n", prefix);
+}
+
+int main(int argc, char **argv) {
+    // Strict policies prevent a missing routine or signature from fabricating a
+    // zero result and displacing later returns. They are probe-only defaults.
+    bool factory = argc == 5 && std::string(argv[2]) == "--sound-factory";
+    bool cstring = argc == 5 && std::string(argv[2]) == "--cstring";
+    bool decode = argc == 4 && std::string(argv[2]) == "--decode";
+    if (argc > 2 && !factory && !decode && !cstring) {
+        fprintf(stderr, "usage: game_boot_probe [verified-executable "
+                        "[--sound-factory module export | --decode hex-address | "
+                        "--cstring hex-address text]]\n");
+        return 2;
+    }
+    if (os_setenv("RECOMP_STRICT_UNKNOWN", "1") || os_setenv("RECOMP_STRICT_IMPORTS", "1"))
+        return 2;
+    const char *exe = argc >= 2 ? argv[1] : recomp_env("EXE");
+    if (!loader_load(exe)) {
+        fprintf(stderr, "[boot-probe] loader: %s\n", loader_error());
+        return 2;
+    }
+    dx_register_shims();
+    if (!verify_mapped_imports(*loader_module_containing(loader_image_base())))
+        return 2;
+    for (uint32_t i = 0; i < loader_module_count(); ++i)
+        if (!verify_mapped_imports(*loader_module(i)))
+            return 2;
+    const char *watchdog = recomp_env("PROBE_WATCHDOG");
+    if (watchdog && *watchdog && argc >= 2) {
+        char *end = nullptr;
+        unsigned long target = strtoul(watchdog, &end, 10);
+        if (!end || *end || !target || target > UINT32_MAX) {
+            fprintf(stderr, "[boot-probe] invalid PROBE_WATCHDOG=%s\n", watchdog);
+            return 2;
+        }
+        g_watch_target.store((uint32_t)target);
+        if (const char *prefix = recomp_env("PROBE_DUMP"); prefix && *prefix)
+            g_watch_prefix = prefix;
+        imports_set_call_observer(spin_watchdog);
+        fprintf(stderr, "[boot-probe] spin watchdog armed: %u TlsGetValue calls, prefix %s\n",
+                (uint32_t)target, g_watch_prefix.c_str());
+    }
+    if (const char *watchdog_cs = recomp_env("PROBE_WATCHDOG_CS"); watchdog_cs && *watchdog_cs && argc >= 2) {
+        char *end = nullptr;
+        unsigned long target = strtoul(watchdog_cs, &end, 10);
+        if (!end || *end || !target || target > UINT32_MAX) {
+            fprintf(stderr, "[boot-probe] invalid PROBE_WATCHDOG_CS=%s\n", watchdog_cs);
+            return 2;
+        }
+        g_watch_cs_target.store((uint32_t)target);
+        if (const char *prefix = recomp_env("PROBE_DUMP"); prefix && *prefix)
+            g_watch_prefix = prefix;
+        imports_set_call_observer(spin_watchdog);
+        fprintf(stderr, "[boot-probe] spin watchdog armed: %u critsec pairs, prefix %s\n",
+                (uint32_t)target, g_watch_prefix.c_str());
+    }
+    if (factory)
+        return probe_sound_factory(argv[3], argv[4]);
+    if (cstring) {
+        char *end = nullptr;
+        unsigned long address = strtoul(argv[3], &end, 16);
+        size_t length = strlen(argv[4]);
+        if (!end || *end || address > UINT32_MAX || !length || length > 4096 ||
+            !loader_in_image(uint32_t(address)))
+            return 2;
+        uint32_t input = heap_alloc(uint32_t(length + 1), true, 16);
+        if (!input)
+            return 2;
+        memcpy(g_mem + input, argv[4], length + 1);
+        X86 *c = loader_context();
+        uint32_t esp = c->r[R_ESP], esi = c->r[R_ESI];
+        sched_set_guest_thread(true);
+        uint32_t output = guest_call(c, uint32_t(address), input, 0);
+        sched_set_guest_thread(false);
+        bool ok = gm_valid(output, uint32_t(length + 1)) &&
+                  !memcmp(g_mem + output, argv[4], length + 1) && c->r[R_ESP] == esp &&
+                  c->r[R_ESI] == esi;
+        fprintf(stderr, "[boot-probe] cstring round trip %08x length=%zu: %s\n", uint32_t(address),
+                length, ok ? "PASS" : "FAIL");
+        return ok ? 0 : 1;
+    }
+    if (decode) {
+        char *end = nullptr;
+        unsigned long address = strtoul(argv[3], &end, 16);
+        if (!end || *end || address > UINT32_MAX || !loader_in_image(uint32_t(address)))
+            return 2;
+        bool ok = interp_can_decode(uint32_t(address));
+        fprintf(stderr, "[boot-probe] bounded decode %08x: %s %s\n", uint32_t(address),
+                ok ? "PASS" : "FAIL", interp_last_error());
+        return ok ? 0 : 1;
+    }
+    fprintf(stderr, "[boot-probe] verified PE %s, entry=%08x, SHA-256=%s\n",
+            loader_exe_path().c_str(), loader_entry_point(), loader_exe_sha256());
+    fprintf(stderr, "[boot-probe] original entry begins; null graphics/audio host\n");
+    fflush(stderr);
+    run_entry();
+    fprintf(stderr, "[boot-probe] original entry returned, eip=%08x esp=%08x exit=%u\n",
+            loader_context()->eip, loader_context()->r[R_ESP], process_exit_code());
+    return process_exited() ? (int)process_exit_code() : 0;
+}
diff --git a/runtime/tests/startup_win32_tests.cpp b/runtime/tests/startup_win32_tests.cpp
new file mode 100644
index 0000000..1081f9f
--- /dev/null
+++ b/runtime/tests/startup_win32_tests.cpp
@@ -0,0 +1,122 @@
+// Exercise CRT startup imports through the real registry and dispatcher.
+// No image, renderer, generated game code or window is needed.
+#include "../imports.h"
+#include "../memory.h"
+#include "../intrinsics.h"
+#include "../../platform/os.h"
+#include <cstdio>
+#include <cstring>
+#include <initializer_list>
+
+static unsigned checks = 0, failures = 0;
+static void check(bool condition, const char *message) {
+    ++checks;
+    if (!condition) {
+        ++failures;
+        printf("FAIL: %s\n", message);
+    }
+}
+
+static uint32_t call(X86 *c, const char *name, std::initializer_list<uint32_t> args) {
+    uint32_t target = imports_resolve("kernel32.dll", name);
+    check(target != 0, "registered export resolves");
+    check(imports_argc(target) == args.size(), "export has the correct stdcall signature");
+    uint32_t before = c->r[R_ESP];
+    c->r[R_ESP] -= 4 * (args.size() + 1);
+    wr32(c->r[R_ESP], 0x12345678);
+    unsigned index = 0;
+    for (uint32_t value : args)
+        wr32(c->r[R_ESP] + 4 + 4 * index++, value);
+    check(imports_dispatch(c, target), "real import dispatcher handles the call");
+    check(c->r[R_ESP] == before, "stdcall restores the caller stack");
+    check(c->eip == 0x12345678, "stdcall resumes at the caller return address");
+    return c->r[R_EAX];
+}
+
+// This must never execute when its calling convention is unknown. A marker
+// distinguishes rejecting the signature from accidentally calling the shim.
+static void unknown_signature_import(X86 *) {
+    fprintf(stderr, "unexpected strict import implementation\n");
+    fflush(stderr);
+}
+
+int main(int argc, char **argv) {
+    mem_init();
+    imports_init();
+    X86 c = {};
+    c.r[R_ESP] = 0x0effff00;
+    if (argc == 2 && strcmp(argv[1], "--strict-unknown") == 0) {
+        os_setenv("RECOMP_STRICT_UNKNOWN", "1");
+        wr32(c.r[R_ESP], 0x12345678);
+        wr16(0x01000000, 0x0b0f); // No interpreted UD2 support: a deliberate unknown body.
+        recomp_unknown_call(&c, 0x01000000);
+        printf("unexpected strict return\n");
+        return 1;
+    }
+    if (argc == 2 && (strcmp(argv[1], "--strict-import") == 0 ||
+                      strcmp(argv[1], "--strict-import-signature") == 0)) {
+        os_setenv("RECOMP_STRICT_IMPORTS", "1");
+        bool signature = strcmp(argv[1], "--strict-import-signature") == 0;
+        uint32_t target = imports_alloc_trampoline(
+            "strict-import-test.dll", signature ? "UnknownConvention" : "MissingImplementation",
+            signature ? unknown_signature_import : nullptr, signature ? ARGC_UNKNOWN : 0);
+        if (!target) {
+            fprintf(stderr, "strict import fixture could not allocate trampoline\n");
+            return 2;
+        }
+        wr32(c.r[R_ESP], 0x12345678);
+        imports_dispatch(&c, target);
+        fprintf(stderr, "unexpected strict import return\n");
+        return 1;
+    }
+    const uint32_t strings = 0x0ee00000, cs = strings + 256;
+    strcpy(reinterpret_cast<char *>(g_mem + strings), "kernel32.dll");
+    uint32_t module = call(&c, "LoadLibraryA", {strings});
+    check(module != 0, "kernel32 has a module handle");
+    strcpy(reinterpret_cast<char *>(g_mem + strings + 32), "InitializeCriticalSectionAndSpinCount");
+    uint32_t resolved = call(&c, "GetProcAddress", {module, strings + 32});
+    check(resolved == imports_resolve("kernel32.dll", "InitializeCriticalSectionAndSpinCount"),
+          "GetProcAddress resolves the same callable spin-count export");
+    call(&c, "GetSystemInfo", {strings + 128});
+    check(rd32(strings + 148) == 1, "the guest exposes one processor");
+    for (uint32_t spin : {0u, 4000u, 0xffffffffu}) {
+        memset(g_mem + cs, 0xa5, 24);
+        wr32(cs - 4, 0x11223344);
+        wr32(cs + 24, 0x55667788);
+        call(&c, "SetLastError", {0x13579});
+        check(call(&c, "InitializeCriticalSectionAndSpinCount", {cs, spin}) == 1,
+              "spin-count initialization returns BOOL success");
+        check(call(&c, "GetLastError", {}) == 0x13579, "initialization preserves last error");
+        check(rd32(cs + 4) == 0xffffffffu && rd32(cs + 8) == 0 && rd32(cs + 12) == 0,
+              "new section is unowned and nonrecursive");
+        check(rd32(cs + 20) == 0, "a single processor ignores the spin count");
+        check(rd32(cs - 4) == 0x11223344 && rd32(cs + 24) == 0x55667788,
+              "initialization stays inside the 24-byte guest object");
+        call(&c, "EnterCriticalSection", {cs});
+        call(&c, "EnterCriticalSection", {cs});
+        check(rd32(cs + 8) == 2 && rd32(cs + 12) != 0, "section ownership permits recursion");
+        call(&c, "LeaveCriticalSection", {cs});
+        call(&c, "LeaveCriticalSection", {cs});
+        check(rd32(cs + 8) == 0 && rd32(cs + 12) == 0, "both leaves release ownership");
+        check(call(&c, "TryEnterCriticalSection", {cs}) == 1, "released section can be reacquired");
+        call(&c, "LeaveCriticalSection", {cs});
+        call(&c, "DeleteCriticalSection", {cs});
+    }
+    strcpy(reinterpret_cast<char *>(g_mem + strings + 32), "IsProcessorFeaturePresent");
+    resolved = call(&c, "GetProcAddress", {module, strings + 32});
+    check(resolved == imports_resolve("kernel32.dll", "IsProcessorFeaturePresent"),
+          "GetProcAddress resolves the same processor-feature export");
+    X86 cpu = {};
+    cpu.r[R_EAX] = 1;
+    recomp_cpuid(&cpu);
+    check((cpu.r[R_EDX] & 0x10) != 0, "CPUID advertises TSC");
+    for (uint32_t feature : {0u, 1u, 2u, 3u, 6u, 8u, 9u, 10u, 12u, 13u, 17u, 0xffffffffu}) {
+        call(&c, "SetLastError", {0x13579});
+        check(call(&c, "IsProcessorFeaturePresent", {feature}) == (feature == 8 ? 1u : 0u),
+              "processor feature agrees with the guest CPU contract");
+        check(call(&c, "GetLastError", {}) == 0x13579, "feature query preserves last error");
+    }
+    printf("%u checks, %u failures\n", checks, failures);
+    mem_shutdown();
+    return failures ? 1 : 0;
+}
