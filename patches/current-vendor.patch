+    uint32_t view = o ? com_view(o, pixel ? IF_D3DPIXELSHADER9 : IF_D3DVERTEXSHADER9) : 0;
+    if (!view) {
+        if (o)
+            com_release(o);
+        com_ret(c, E_OUTOFMEMORY);
+        return;
+    }
+    o->dev_d3d = dev->id;
+    shader_objects()[o->id].code.bytes = std::move(code);
+    wr32(out, view);
+    com_ret(c, D3D_OK9);
